{
  "cleanupPeriodDays": 3650,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/llm-dlc/tools/sync.py\" hook",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/llm-dlc/tools/sync.py\" hook",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/llm-dlc/tools/sync.py\" hook-commit",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 llm-dlc/tools/sync.py commit:*)",
      "Bash(python3 llm-dlc/tools/sync.py check:*)",
      "Bash(python3 llm-dlc/tools/sync.py sync:*)",
      "Bash(jj status:*)",
      "Bash(jj diff:*)",
      "Bash(jj log:*)",
      "Bash(jj show:*)",
      "Bash(jj trace-commit:*)"
    ]
  }
}
