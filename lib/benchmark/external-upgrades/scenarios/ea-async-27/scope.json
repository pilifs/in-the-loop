{
  "entry": "com.ea.async.instrumentation.Transformer#transform(Ljava/lang/ClassLoader;Lorg/objectweb/asm/ClassReader;)[B",
  "probeClass": "UpgradeProbe",
  "observer": "Transform and execute eight fixed bytecode/future combinations. Read completion at return and the eventual integer.",
  "basis": "Each class has zero through three extra uninitialized stack copies across await. The already resolved input completes synchronously. The pending input completes after the argument is supplied. The generated function constructs the integer represented by that argument. The same original class bytes are passed on both releases.",
  "cases": [
    {
      "args": [
        "",
        "true",
        "100"
      ],
      "expected": {
        "return": "true/100"
      }
    },
    {
      "args": [
        "",
        "false",
        "101"
      ],
      "expected": {
        "return": "false/101"
      }
    },
    {
      "args": [
        "",
