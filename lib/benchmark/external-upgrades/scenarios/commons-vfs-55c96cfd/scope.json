{
  "entry": "org.apache.commons.vfs2.provider.ftp.FtpFileObject#doGetType()Lorg/apache/commons/vfs2/FileType;",
  "probeClass": "org.apache.commons.vfs2.provider.ftp.UpgradeProbe",
  "observer": "The original VFS FTP client classifies a file, a directory and an absent path on a real loopback FTP server.",
  "basis": "The server root contains one actual file and one actual directory. The Apache FTPServer and MINA versions come from the original project test environment and are held fixed on both sides. Each observation has its own temporary root and listener.",
  "cases": [
    {
      "args": [
        "entry.dat"
      ],
      "expected": {
        "return": "file"
      }
    },
    {
      "args": [
        "folder"
      ],
      "expected": {
        "return": "folder"
      }
    },
    {
      "args": [
        "absent"
      ],
      "expected": {
        "return": "missing"
      }
    }
  ],
  "runtimeCompanions": [
    {
