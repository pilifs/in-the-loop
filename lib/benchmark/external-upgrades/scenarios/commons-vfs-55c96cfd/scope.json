      "sha256": "36e47834dfa4225448aaaa5460b304f26e99e837c4a80ef5b41d090735be9b07"
    },
    {
      "mavenPath": "org/apache/mina/mina-core/2.2.5/mina-core-2.2.5.jar",
      "sha256": "b75036dc5102d3aad419e74cc7c0c2f573dded48b8c97c6b070d5daed1ed0c62"
    }
  ]
