        "0991234567"
      ],
      "expected": {
        "return": "0@0/09@0/099@0/099 1@5/099 12@5/099 123@5/099 123 4@5/099 123 45@5/099 123 456@5/099 123 4567@5|clear@0|0@0/09@0/099@0/099 1@5/099 12@5/099 123@5/099 123 4@5/099 123 45@5/099 123 456@5/099 123 4567@5"
