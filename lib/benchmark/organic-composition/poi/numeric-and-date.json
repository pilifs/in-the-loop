{
  "entry": "org.apache.poi.ss.usermodel.DataFormatter#formatRawCellContents(DILjava/lang/String;)Ljava/lang/String;",
  "probeClass": "UpgradeProbe",
  "observer": "Exact retained, repeated and fresh-peer display text, current POI locale, decimal separator and final quoted abbreviation across an A/B/A locale history.",
  "basis": "Single-section currency pattern from the landed POI test; independent ordinary numeric formatting and the Gregorian calendar date at Excel serial 45292. Both initial user locales are registered.",
  "cases": [
    {
      "args": [
        "numeric",
        "en-US"
      ],
      "expected": {
        "return": "en-US[.]:0.0~0.0~0.0~literal=false|kk-KZ[,]:0,0~0,0~0,0~literal=false|en-US[.]:0.0~0.0~0.0~literal=false"
      }
    },
    {
      "args": [
        "numeric",
        "kk-KZ"
      ],
      "expected": {
        "return": "kk-KZ[,]:0,0~0,0~0,0~literal=false|en-US[.]:0.0~0.0~0.0~literal=false|kk-KZ[,]:0,0~0,0~0,0~literal=false"
      }
    },
    {
      "args": [
        "date",
        "en-US"
      ],
      "expected": {
        "return": "en-US[.]:2024-01-01~2024-01-01~2024-01-01~literal=false|kk-KZ[,]:2024-01-01~2024-01-01~2024-01-01~literal=false|en-US[.]:2024-01-01~2024-01-01~2024-01-01~literal=false"
      }
    },
    {
      "args": [
        "date",
        "kk-KZ"
      ],
      "expected": {
        "return": "kk-KZ[,]:2024-01-01~2024-01-01~2024-01-01~literal=false|en-US[.]:2024-01-01~2024-01-01~2024-01-01~literal=false|kk-KZ[,]:2024-01-01~2024-01-01~2024-01-01~literal=false"
      }
    }
  ]
}
