{
  "entry": "org.threeten.bp.format.DateTimeFormatter#parse(Ljava/lang/CharSequence;Ljava/text/ParsePosition;)Lorg/threeten/bp/temporal/TemporalAccessor;",
  "probeClass": "UpgradeProbe",
  "observer": "Earlier-offset double read and cursor-only history including terminal failure.",
  "basis": "New York and Berlin 2016 civil-time overlap arithmetic and a single caller-owned ParsePosition. Terminal failure records the exception and cursor error indices.",
  "cases": [
    {
      "args": [
        "instant",
        "2016-11-06T01:00-04:00[America/New_York]",
        "2016-11-06T01:00-04:00[America/New_York]"
      ],
      "expected": {
        "return": "2016-11-06T05:00:00Z/40/-1|2016-11-06T05:00:00Z/80/-1|end@80/80/80"
      }
    },
    {
      "args": [
        "cursor",
        "2016-11-06T01:00-04:00[America/New_York]",
        "2016-11-06T01:00-05:00[America/New_York]"
      ],
      "expected": {
        "return": "/40/-1|/80/-1|end@80/80/80"
      }
    },
    {
      "args": [
        "instant",
        "2016-10-30T02:00+02:00[Europe/Berlin]",
        "2016-10-30T02:00+02:00[Europe/Berlin]"
      ],
      "expected": {
        "return": "2016-10-30T00:00:00Z/37/-1|2016-10-30T00:00:00Z/74/-1|end@74/74/74"
      }
    },
    {
      "args": [
        "cursor",
        "2016-10-30T02:00+02:00[Europe/Berlin]",
        "2016-10-30T02:00+01:00[Europe/Berlin]"
      ],
      "expected": {
        "return": "/37/-1|/74/-1|end@74/74/74"
      }
    }
  ]
}
