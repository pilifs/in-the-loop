{
  "contract": {
    "subject": "shop.Pricing#total",
    "inputs": [
      {
        "name": "q",
        "type": "shop.Quote",
        "derivation": {
          "kind": "identity"
        }
      }
    ],
    "required": [
      "result",
      "exception"
    ]
  },
  "closures": {
    "before": "computed by cache::key",
    "after": "computed by cache::key"
  },
  "domain": {
    "classes": [
      "shop.Quote",
      "shop.Money"
    ],
    "bounds": {
      "before": {
        "input_objects": 1,
        "allocations": 0
      },
      "after": {
        "input_objects": 2,
        "allocations": 2
      }
    },
    "nullable": [],
    "may_alias": [],
    "made_by": {
      "kind": "constructors",
