        "before: shop.Quote(long cents, int quantity)",
        "after: shop.Quote(shop.Money amount, int quantity)",
        "after: shop.Money(long cents)"
      ]
    },
    "label": "q: a shop.Quote made by its constructor (before: shop.Quote(long, int); after: shop.Quote(shop.Money, int) of a shop.Money(long)), from any arguments it accepts"
  },
  "observations": [
    {
      "kind": "result"
    },
    {
      "kind": "exception"
    }
  ],
  "correspondence": {
