      {
        "old": "old.q.cents",
        "new": "new.q.amount.cents"
      },
      {
        "old": "old.q.quantity",
        "new": "new.q.quantity"
      }
    ],
    "outputs": []
  },
  "bounds": {
    "unwind": 16,
    "max_array_length": 8
  },
  "assumptions": [],
  "tools": {
    "models": "computed",
    "jdk": "computed",
    "checker": "native strict",
    "binary": "computed"
  }
}
