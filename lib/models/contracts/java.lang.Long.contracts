# Part of the contract library of jvmcontract's own checker (lib/models/contracts/README.md): contracts for its gaps,
# checked once and recorded in checked.json, which runs under --gaps advised apply without checking them again.
kind: gap-contracts

jdk-static-method:java.lang.Long.numberOfLeadingZeros(J)I@jdk-25.0.4.1
  call: java.lang.Long.numberOfLeadingZeros(long i) -> int
  assert: (i == 0L && result == 64) || (i != 0L && 0 <= result && result < 64 && (i >>> (63 - result)) == 1L)
  modifies: nothing
  written-by: an agent (Claude Opus 5.5), from the documentation of Long.numberOfLeadingZeros(long): 64 for zero, else the zeros above the highest one bit
