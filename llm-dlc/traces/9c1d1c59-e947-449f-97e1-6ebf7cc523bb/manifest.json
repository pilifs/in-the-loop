  "commits": [
    {
      "change_id": "uktymptmzmwvwvvyrokxrmntmkyoqtlo",
      "commit_id": null,
      "immutable": false,
      "summary": "Start the setup record for the twenty additional organic Java PRs",
      "body": "Fetched the 40 pinned upstream revisions of J01-J20 into shallow mirrors, made one worktree per revision outside the checkout, and recorded each commit's tree and parents. Every fix's first parent is the brief's parent and every PR's merge commit equals the brief's fix revision (checked with gh api). Builds, releases and landed tests follow.",
      "log_sha256": "025806cc43edec1b4d7c2d063864dcc2d35cb88196354691baa173d32217cb1d"
    },
    {
      "change_id": "rqovmytvnyukmwxqyouwoyrtktsqtkku",
      "commit_id": null,
      "immutable": false,
      "summary": "Queue the first upstream builds for the twenty-case setup (verification pending)",
      "body": "Four setup jobs build an upstream project at both pinned revisions of a case and run its landed test on the fix, on the parent, and transplanted onto the parent: Calcite core with CoreQuidemTest (J12, 20261124-203257-setup-build-apache-calcite-core-at-both), POI poi-ooxml with TestXSSFHyperlink (J05, 20261124-203508-setup-build-apache-poi-s-poi-ooxml-at-bo), Eclipse Collections with the UnifiedMap tests of unit-tests-java8 (J17, 20261124-203508-setup-build-eclipse-collections-at-both), and Lucene core and join with the block-join tests (J14, 20261124-203513-setup-build-lucene-core-and-join-at-both). Each was too long to run inline. Their dependencies were resolved online in the setup cache first.",
      "log_sha256": "cc75d8801a46a5acb2ba2f164ffe744f39a9b4a3c6eb8974b38c9482729324b8"
    },
    {
      "change_id": "urulzqpoksnvqyyylnvkvzmnqmwqqvmy",
      "commit_id": null,
      "immutable": false,
      "summary": "Record the builds, overlays and landed tests of the twenty-case setup",
      "body": "The setup record now has, for each of J01-J20, the toolchain, the built or overlay jars with their sha256 and class digests, the release graph each overlay is compiled over (and which side of the PR that release already equals), the landed test run on the fix, on the parent and transplanted onto the parent, the setup probes of the brief's preflight observations, and the exact commands with their checked offline forms. Every landed test or probe that could run matched the brief. Four upstream builds (POI, Calcite, Eclipse Collections, Lucene) are queued jobs; five upstream builds cannot run (gone or credentialed repositories, a missing thrift binary) and the record says why. The PGP pass and the notes for the domain agent follow.",
      "log_sha256": "8bce00e3d9924c51378d7f3d1d38a193399f3e9e1caf4824a4867ecd882a61cb"
    }
  ],
