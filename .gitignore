# Build outputs
build/
.gradle/
target/
out/
*.class
!examples/**/fixtures/*.class

# Lean / Rocq / Isabelle
.lake/
*.vo
*.vok
*.vos
*.glob
.*.aux

# Model checkers
states/
*.tlc.out

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store

# Local secrets (generated by llm-dlc/infra/langfuse/up.sh)
.env
*.tmp
__pycache__/

# LLM trace log snapshots: content-addressed, uploaded separately (llm-dlc/specification.md)
llm-dlc/traces/*/logs/

# A fork of the CProver models library that an earlier version of the tool used; its models now live in lib/models,
# and a clone left here from that time stays untracked.
libs/java-models-library/

# The models of JDK classes jvmcontract embeds (lib/models/README.md): compiled by lib/models/build.sh, committed so
# that the crate builds without a javac, and checked against the sources by a test.
!lib/models/classes/
!lib/models/classes/**/*.class

# The verification pipeline's local state and machine overrides (verification/README.md)
verification/.state/
verification/pipeline.local.toml

# The feature loop's record of each run, for the person who ran it (llm-dlc/README.md#unattended-loops)
llm-dlc/loop-summaries/
