      "file": "examples/apps/crosscut/src/main/java/net/terminalvalue/crosscut/ratelimit/TokenBucket.java",
      "startLine": 17,
      "code": "    }\n\n    /**\n     * The time up to which refills have been credited after the refill: {@code lastNanos} advanced by the whole\n     * periods that earned a token, which is {@code nowNanos} less the part of a period that has not earned one yet.\n     * That part is kept, so that a bucket polled more often than it refills still refills.\n     */\n    public static long lastAfter(long tokens, long lastNanos, long nowNanos, long periodNanos, long capacity) {\n        return nowNanos - (nowNanos - lastNanos) % periodNanos;\n    }\n}\n"
    },
    "after": {
      "file": "examples/apps/crosscut/src/main/java/net/terminalvalue/crosscut/ratelimit/TokenBucket.java",
      "startLine": 17,
      "code": "    }\n\n    /**\n     * The time up to which refills have been credited after the refill: the start of the period {@code nowNanos}\n     * falls in, on the clock's grid of whole periods, as the fixed window aligns its start. The part of a period\n     * that has not earned a token yet is left after it, so that a bucket polled more often than it refills still\n     * refills.\n     */\n    public static long lastAfter(long tokens, long lastNanos, long nowNanos, long periodNanos, long capacity) {\n        return nowNanos - nowNanos % periodNanos;\n    }\n}\n"
    },
