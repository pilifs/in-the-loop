# Behavioural contract, generated by jvmcontract. Do not edit: regenerate it with `jvmcontract update`.
# It lists the outcome of every possible input, and the build checks it against the bytecode.
# A change here is a change in what the code does: review it like an API change.
target: net.terminalvalue.crosscut.tx.TransactionBoundary#enter
domain: Propagation (8) × boolean (2) = 16 cases

enter(REQUIRED, false)      => BEGIN
enter(REQUIRED, true)       => JOIN
enter(REQUIRES_NEW, false)  => BEGIN
enter(REQUIRES_NEW, true)   => SUSPEND_AND_BEGIN
enter(SUPPORTS, false)      => RUN_OUTSIDE
enter(SUPPORTS, true)       => JOIN
enter(NOT_SUPPORTED, false) => RUN_OUTSIDE
enter(NOT_SUPPORTED, true)  => SUSPEND_AND_RUN_OUTSIDE
enter(MANDATORY, false)     => throws IllegalStateException("No existing transaction found for transaction marked with propagation 'mandatory'")
enter(MANDATORY, true)      => JOIN
enter(NEVER, false)         => RUN_OUTSIDE
enter(NEVER, true)          => throws IllegalStateException("Existing transaction found for transaction marked with propagation 'never'")
enter(NESTED, false)        => BEGIN
enter(NESTED, true)         => SAVEPOINT
enter(null, false)          => throws NullPointerException
enter(null, true)           => throws NullPointerException
