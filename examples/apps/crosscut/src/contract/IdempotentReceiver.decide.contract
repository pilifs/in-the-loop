# Behavioural contract, generated by jvmcontract. Do not edit: regenerate it with `jvmcontract update`.
# It lists the outcome of every possible input, and the build checks it against the bytecode.
# A change here is a change in what the code does: review it like an API change.
target: net.terminalvalue.crosscut.idempotency.IdempotentReceiver#decide
domain: KeyState (4) × ReceiverEvent (6) = 24 cases

decide(ABSENT, Request[sameFingerprint=false])      => Transition[next=IN_PROGRESS, effects=[EXECUTE]]
decide(ABSENT, Request[sameFingerprint=true])       => Transition[next=IN_PROGRESS, effects=[EXECUTE]]
decide(ABSENT, Completed[])                         => Unchanged[reason="no attempt is in progress"]
decide(ABSENT, Failed[])                            => Unchanged[reason="no attempt is in progress"]
decide(ABSENT, Expired[])                           => Unchanged[reason="nothing to expire"]
decide(ABSENT, null)                                => throws NullPointerException
decide(IN_PROGRESS, Request[sameFingerprint=false]) => Rejected[reason="the key was reused for a different request"]
decide(IN_PROGRESS, Request[sameFingerprint=true])  => Rejected[reason="a request with this key is in progress"]
decide(IN_PROGRESS, Completed[])                    => Transition[next=COMPLETED, effects=[STORE_RESPONSE]]
decide(IN_PROGRESS, Failed[])                       => Transition[next=ABSENT, effects=[RELEASE_KEY]]
decide(IN_PROGRESS, Expired[])                      => Unchanged[reason="a key in progress does not expire"]
decide(IN_PROGRESS, null)                           => throws NullPointerException
decide(COMPLETED, Request[sameFingerprint=false])   => Rejected[reason="the key was reused for a different request"]
decide(COMPLETED, Request[sameFingerprint=true])    => Transition[next=COMPLETED, effects=[REPLAY_RESPONSE]]
decide(COMPLETED, Completed[])                      => Unchanged[reason="no attempt is in progress"]
decide(COMPLETED, Failed[])                         => Unchanged[reason="no attempt is in progress"]
decide(COMPLETED, Expired[])                        => Transition[next=ABSENT, effects=[RELEASE_KEY]]
decide(COMPLETED, null)                             => throws NullPointerException
decide(null, Request[sameFingerprint=false])        => throws NullPointerException
decide(null, Request[sameFingerprint=true])         => throws NullPointerException
decide(null, Completed[])                           => throws NullPointerException
decide(null, Failed[])                              => throws NullPointerException
decide(null, Expired[])                             => throws NullPointerException
decide(null, null)                                  => throws NullPointerException
