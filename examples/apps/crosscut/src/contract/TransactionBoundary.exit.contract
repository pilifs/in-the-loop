# Behavioural contract, generated by jvmcontract. Do not edit: regenerate it with `jvmcontract update`.
# It lists the outcome of every possible input, and the build checks it against the bytecode.
# A change here is a change in what the code does: review it like an API change.
target: net.terminalvalue.crosscut.tx.TransactionBoundary#exit
domain: Completion (11) × boolean (2) = 22 cases

exit(Returned[], false)                                          => COMMIT
exit(Returned[], true)                                           => ROLLBACK_UNEXPECTED
exit(Threw[kind=RUNTIME_EXCEPTION, rule=NONE], false)            => ROLLBACK
exit(Threw[kind=RUNTIME_EXCEPTION, rule=NONE], true)             => ROLLBACK
exit(Threw[kind=RUNTIME_EXCEPTION, rule=ROLLBACK_FOR], false)    => ROLLBACK
exit(Threw[kind=RUNTIME_EXCEPTION, rule=ROLLBACK_FOR], true)     => ROLLBACK
exit(Threw[kind=RUNTIME_EXCEPTION, rule=NO_ROLLBACK_FOR], false) => COMMIT
exit(Threw[kind=RUNTIME_EXCEPTION, rule=NO_ROLLBACK_FOR], true)  => ROLLBACK
exit(Threw[kind=ERROR, rule=NONE], false)                        => ROLLBACK
exit(Threw[kind=ERROR, rule=NONE], true)                         => ROLLBACK
exit(Threw[kind=ERROR, rule=ROLLBACK_FOR], false)                => ROLLBACK
exit(Threw[kind=ERROR, rule=ROLLBACK_FOR], true)                 => ROLLBACK
exit(Threw[kind=ERROR, rule=NO_ROLLBACK_FOR], false)             => COMMIT
exit(Threw[kind=ERROR, rule=NO_ROLLBACK_FOR], true)              => ROLLBACK
exit(Threw[kind=CHECKED_EXCEPTION, rule=NONE], false)            => COMMIT
exit(Threw[kind=CHECKED_EXCEPTION, rule=NONE], true)             => ROLLBACK
exit(Threw[kind=CHECKED_EXCEPTION, rule=ROLLBACK_FOR], false)    => ROLLBACK
exit(Threw[kind=CHECKED_EXCEPTION, rule=ROLLBACK_FOR], true)     => ROLLBACK
exit(Threw[kind=CHECKED_EXCEPTION, rule=NO_ROLLBACK_FOR], false) => COMMIT
exit(Threw[kind=CHECKED_EXCEPTION, rule=NO_ROLLBACK_FOR], true)  => ROLLBACK
exit(null, false)                                                => throws NullPointerException
exit(null, true)                                                 => throws NullPointerException
