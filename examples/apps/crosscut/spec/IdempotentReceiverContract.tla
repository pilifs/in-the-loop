---- MODULE IdempotentReceiverContract ----
\* Generated by jvmcontract from the behavioural contract of net.terminalvalue.crosscut.idempotency.IdempotentReceiver#decide. Do not edit.
\* Each arm is one case of the contract, which jvmcontract proves against the compiled bytecode. Rows with
\* a null status or input are omitted: the protocol never passes null. The first arm's `\A i \in {1, 2} : i = i` is for
\* TLC's coverage report, which folds a subtree whose counts are all equal and would then not list the arms
\* an action always takes the same one of; a conjunct evaluated twice keeps the counts unequal.

Transition(next, effects) == [kind |-> "Transition", next |-> next, effects |-> effects]
Unchanged == [kind |-> "Unchanged", effects |-> << >>]
Rejected == [kind |-> "Rejected", effects |-> << >>]

Decide(status, input) ==
  CASE (\A i \in {1, 2} : i = i) /\ status = "ABSENT" /\ input = [kind |-> "Request", sameFingerprint |-> FALSE] -> Transition("IN_PROGRESS", <<"EXECUTE">>)
    [] status = "ABSENT" /\ input = [kind |-> "Request", sameFingerprint |-> TRUE] -> Transition("IN_PROGRESS", <<"EXECUTE">>)
    [] status = "ABSENT" /\ input = [kind |-> "Completed"] -> Unchanged
    [] status = "ABSENT" /\ input = [kind |-> "Failed"] -> Unchanged
    [] status = "ABSENT" /\ input = [kind |-> "Expired"] -> Unchanged
    [] status = "IN_PROGRESS" /\ input = [kind |-> "Request", sameFingerprint |-> FALSE] -> Rejected
    [] status = "IN_PROGRESS" /\ input = [kind |-> "Request", sameFingerprint |-> TRUE] -> Rejected
    [] status = "IN_PROGRESS" /\ input = [kind |-> "Completed"] -> Transition("COMPLETED", <<"STORE_RESPONSE">>)
    [] status = "IN_PROGRESS" /\ input = [kind |-> "Failed"] -> Transition("ABSENT", <<"RELEASE_KEY">>)
    [] status = "IN_PROGRESS" /\ input = [kind |-> "Expired"] -> Unchanged
    [] status = "COMPLETED" /\ input = [kind |-> "Request", sameFingerprint |-> FALSE] -> Rejected
    [] status = "COMPLETED" /\ input = [kind |-> "Request", sameFingerprint |-> TRUE] -> Transition("COMPLETED", <<"REPLAY_RESPONSE">>)
    [] status = "COMPLETED" /\ input = [kind |-> "Completed"] -> Unchanged
    [] status = "COMPLETED" /\ input = [kind |-> "Failed"] -> Unchanged
    [] status = "COMPLETED" /\ input = [kind |-> "Expired"] -> Transition("ABSENT", <<"RELEASE_KEY">>)

