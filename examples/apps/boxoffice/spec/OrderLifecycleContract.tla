---- MODULE OrderLifecycleContract ----
\* Generated by examples/tools/tla/contract_to_tla.py from OrderLifecycle.decide.contract. Do not edit.
\* Each arm is one case of the behavioural contract of OrderLifecycle#decide, which examples/tools/contracts
\* proves against the compiled bytecode. Rows with a null status or input are omitted: the protocol never
\* passes null.

Transition(next, effects) == [kind |-> "Transition", next |-> next, effects |-> effects]
Unchanged == [kind |-> "Unchanged", effects |-> << >>]
Rejected == [kind |-> "Rejected", effects |-> << >>]

Decide(status, input) ==
  CASE status = "PENDING_PAYMENT" /\ input = [kind |-> "PaymentCaptured", seatsStillHeld |-> FALSE] -> Transition("REFUND_PENDING", <<"REQUEST_REFUND">>)
    [] status = "PENDING_PAYMENT" /\ input = [kind |-> "PaymentCaptured", seatsStillHeld |-> TRUE] -> Transition("CONFIRMED", <<"SELL_SEATS">>)
    [] status = "PENDING_PAYMENT" /\ input = [kind |-> "PaymentDeclined"] -> Transition("DECLINED", <<"RELEASE_SEATS">>)
    [] status = "PENDING_PAYMENT" /\ input = [kind |-> "PaymentRefunded"] -> Unchanged
    [] status = "PENDING_PAYMENT" /\ input = [kind |-> "CancellationRequested"] -> Rejected
    [] status = "CONFIRMED" /\ input = [kind |-> "PaymentCaptured", seatsStillHeld |-> FALSE] -> Unchanged
    [] status = "CONFIRMED" /\ input = [kind |-> "PaymentCaptured", seatsStillHeld |-> TRUE] -> Unchanged
    [] status = "CONFIRMED" /\ input = [kind |-> "PaymentDeclined"] -> Unchanged
    [] status = "CONFIRMED" /\ input = [kind |-> "PaymentRefunded"] -> Unchanged
    [] status = "CONFIRMED" /\ input = [kind |-> "CancellationRequested"] -> Transition("REFUND_PENDING", <<"RELEASE_SEATS", "REQUEST_REFUND">>)
    [] status = "DECLINED" /\ input = [kind |-> "PaymentCaptured", seatsStillHeld |-> FALSE] -> Transition("REFUND_PENDING", <<"REQUEST_REFUND">>)
    [] status = "DECLINED" /\ input = [kind |-> "PaymentCaptured", seatsStillHeld |-> TRUE] -> Transition("REFUND_PENDING", <<"REQUEST_REFUND">>)
    [] status = "DECLINED" /\ input = [kind |-> "PaymentDeclined"] -> Unchanged
    [] status = "DECLINED" /\ input = [kind |-> "PaymentRefunded"] -> Unchanged
    [] status = "DECLINED" /\ input = [kind |-> "CancellationRequested"] -> Rejected
    [] status = "REFUND_PENDING" /\ input = [kind |-> "PaymentCaptured", seatsStillHeld |-> FALSE] -> Unchanged
    [] status = "REFUND_PENDING" /\ input = [kind |-> "PaymentCaptured", seatsStillHeld |-> TRUE] -> Unchanged
    [] status = "REFUND_PENDING" /\ input = [kind |-> "PaymentDeclined"] -> Unchanged
    [] status = "REFUND_PENDING" /\ input = [kind |-> "PaymentRefunded"] -> Transition("REFUNDED", <<>>)
    [] status = "REFUND_PENDING" /\ input = [kind |-> "CancellationRequested"] -> Unchanged
    [] status = "REFUNDED" /\ input = [kind |-> "PaymentCaptured", seatsStillHeld |-> FALSE] -> Unchanged
    [] status = "REFUNDED" /\ input = [kind |-> "PaymentCaptured", seatsStillHeld |-> TRUE] -> Unchanged
    [] status = "REFUNDED" /\ input = [kind |-> "PaymentDeclined"] -> Unchanged
    [] status = "REFUNDED" /\ input = [kind |-> "PaymentRefunded"] -> Unchanged
    [] status = "REFUNDED" /\ input = [kind |-> "CancellationRequested"] -> Unchanged

