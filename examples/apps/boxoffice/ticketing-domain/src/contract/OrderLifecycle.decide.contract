target: net.terminalvalue.boxoffice.ticketing.domain.OrderLifecycle#decide
domain: OrderStatus (6) × OrderInput (6) = 36 cases

decide(PENDING_PAYMENT, PaymentCaptured[seatsStillHeld=false]) => Transition[next=REFUND_PENDING, effects=[REQUEST_REFUND]]
decide(PENDING_PAYMENT, PaymentCaptured[seatsStillHeld=true])  => Transition[next=CONFIRMED, effects=[SELL_SEATS]]
decide(PENDING_PAYMENT, PaymentDeclined[])                     => Transition[next=DECLINED, effects=[RELEASE_SEATS]]
decide(PENDING_PAYMENT, PaymentRefunded[])                     => Unchanged[reason="no refund outstanding"]
decide(PENDING_PAYMENT, CancellationRequested[])               => Rejected[reason="payment is in progress; try again shortly"]
decide(PENDING_PAYMENT, null)                                  => throws NullPointerException
decide(CONFIRMED, PaymentCaptured[seatsStillHeld=false])       => Unchanged[reason="payment already recorded"]
decide(CONFIRMED, PaymentCaptured[seatsStillHeld=true])        => Unchanged[reason="payment already recorded"]
decide(CONFIRMED, PaymentDeclined[])                           => Unchanged[reason="payment outcome already recorded"]
decide(CONFIRMED, PaymentRefunded[])                           => Unchanged[reason="no refund outstanding"]
decide(CONFIRMED, CancellationRequested[])                     => Transition[next=REFUND_PENDING, effects=[RELEASE_SEATS, REQUEST_REFUND]]
decide(CONFIRMED, null)                                        => throws NullPointerException
decide(DECLINED, PaymentCaptured[seatsStillHeld=false])        => Transition[next=REFUND_PENDING, effects=[REQUEST_REFUND]]
decide(DECLINED, PaymentCaptured[seatsStillHeld=true])         => Transition[next=REFUND_PENDING, effects=[REQUEST_REFUND]]
decide(DECLINED, PaymentDeclined[])                            => Unchanged[reason="payment outcome already recorded"]
decide(DECLINED, PaymentRefunded[])                            => Unchanged[reason="no refund outstanding"]
decide(DECLINED, CancellationRequested[])                      => Rejected[reason="the order was never paid"]
decide(DECLINED, null)                                         => throws NullPointerException
decide(REFUND_PENDING, PaymentCaptured[seatsStillHeld=false])  => Unchanged[reason="payment already recorded"]
decide(REFUND_PENDING, PaymentCaptured[seatsStillHeld=true])   => Unchanged[reason="payment already recorded"]
decide(REFUND_PENDING, PaymentDeclined[])                      => Unchanged[reason="payment outcome already recorded"]
decide(REFUND_PENDING, PaymentRefunded[])                      => Transition[next=REFUNDED, effects=[]]
decide(REFUND_PENDING, CancellationRequested[])                => Unchanged[reason="already cancelled"]
decide(REFUND_PENDING, null)                                   => throws NullPointerException
decide(REFUNDED, PaymentCaptured[seatsStillHeld=false])        => Unchanged[reason="payment already recorded"]
decide(REFUNDED, PaymentCaptured[seatsStillHeld=true])         => Unchanged[reason="payment already recorded"]
decide(REFUNDED, PaymentDeclined[])                            => Unchanged[reason="payment outcome already recorded"]
decide(REFUNDED, PaymentRefunded[])                            => Unchanged[reason="no refund outstanding"]
decide(REFUNDED, CancellationRequested[])                      => Unchanged[reason="already cancelled"]
decide(REFUNDED, null)                                         => throws NullPointerException
decide(null, PaymentCaptured[seatsStillHeld=false])            => throws NullPointerException
decide(null, PaymentCaptured[seatsStillHeld=true])             => throws NullPointerException
decide(null, PaymentDeclined[])                                => throws NullPointerException
decide(null, PaymentRefunded[])                                => throws NullPointerException
decide(null, CancellationRequested[])                          => throws NullPointerException
decide(null, null)                                             => throws NullPointerException
