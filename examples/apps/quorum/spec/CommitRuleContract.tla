---- MODULE CommitRuleContract ----
\* Generated by jvmcontract from the behavioural contract of net.terminalvalue.quorum.raft.CommitRule#decide. Do not edit.
\* Each arm is one case of the contract, which jvmcontract proves against the compiled bytecode. Rows with
\* a null status or input are omitted: the protocol never passes null. The first arm's `\A i \in {1, 2} : i = i` is for
\* TLC's coverage report, which folds a subtree whose counts are all equal and would then not list the arms
\* an action always takes the same one of; a conjunct evaluated twice keeps the counts unequal.

Transition(next, effects) == [kind |-> "Transition", next |-> next, effects |-> effects]
Unchanged == [kind |-> "Unchanged", effects |-> << >>]
Rejected == [kind |-> "Rejected", effects |-> << >>]

Decide(status, input) ==
  CASE (\A i \in {1, 2} : i = i) /\ status = "PENDING" /\ input = [kind |-> "Replication", term |-> "OLDER", majority |-> FALSE] -> Unchanged
    [] status = "PENDING" /\ input = [kind |-> "Replication", term |-> "OLDER", majority |-> TRUE] -> Unchanged
    [] status = "PENDING" /\ input = [kind |-> "Replication", term |-> "CURRENT", majority |-> FALSE] -> Unchanged
    [] status = "PENDING" /\ input = [kind |-> "Replication", term |-> "CURRENT", majority |-> TRUE] -> Transition("COMMITTED", <<"APPLY">>)
    [] status = "PENDING" /\ input = [kind |-> "Replication", term |-> "NEWER", majority |-> FALSE] -> [kind |-> "Throws", exception |-> "IllegalStateException", effects |-> << >>]
    [] status = "PENDING" /\ input = [kind |-> "Replication", term |-> "NEWER", majority |-> TRUE] -> [kind |-> "Throws", exception |-> "IllegalStateException", effects |-> << >>]
    [] status = "COMMITTED" /\ input = [kind |-> "Replication", term |-> "OLDER", majority |-> FALSE] -> Unchanged
    [] status = "COMMITTED" /\ input = [kind |-> "Replication", term |-> "OLDER", majority |-> TRUE] -> Unchanged
    [] status = "COMMITTED" /\ input = [kind |-> "Replication", term |-> "CURRENT", majority |-> FALSE] -> Unchanged
    [] status = "COMMITTED" /\ input = [kind |-> "Replication", term |-> "CURRENT", majority |-> TRUE] -> Unchanged
    [] status = "COMMITTED" /\ input = [kind |-> "Replication", term |-> "NEWER", majority |-> FALSE] -> Unchanged
    [] status = "COMMITTED" /\ input = [kind |-> "Replication", term |-> "NEWER", majority |-> TRUE] -> Unchanged

