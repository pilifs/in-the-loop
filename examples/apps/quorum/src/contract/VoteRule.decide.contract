# Behavioural contract, generated by jvmcontract. Do not edit: regenerate it with `jvmcontract update`.
# It lists the outcome of every possible input, and the build checks it against the bytecode.
# A change here is a change in what the code does: review it like an API change.
target: net.terminalvalue.quorum.raft.VoteRule#decide
domain: Ballot (4) × VoteRequest (10) = 40 cases

decide(OPEN, VoteRequest[term=OLDER, log=BEHIND])                => Rejected[reason="a candidate from the past"]
decide(OPEN, VoteRequest[term=OLDER, log=EVEN])                  => Rejected[reason="a candidate from the past"]
decide(OPEN, VoteRequest[term=OLDER, log=AHEAD])                 => Rejected[reason="a candidate from the past"]
decide(OPEN, VoteRequest[term=CURRENT, log=BEHIND])              => Rejected[reason="a log behind the voter's"]
decide(OPEN, VoteRequest[term=CURRENT, log=EVEN])                => Transition[next=FOR_THE_CANDIDATE, effects=[GRANT]]
decide(OPEN, VoteRequest[term=CURRENT, log=AHEAD])               => Transition[next=FOR_THE_CANDIDATE, effects=[GRANT]]
decide(OPEN, VoteRequest[term=NEWER, log=BEHIND])                => Rejected[reason="a log behind the voter's"]
decide(OPEN, VoteRequest[term=NEWER, log=EVEN])                  => Transition[next=FOR_THE_CANDIDATE, effects=[GRANT]]
decide(OPEN, VoteRequest[term=NEWER, log=AHEAD])                 => Transition[next=FOR_THE_CANDIDATE, effects=[GRANT]]
decide(OPEN, null)                                               => throws NullPointerException
decide(FOR_THE_CANDIDATE, VoteRequest[term=OLDER, log=BEHIND])   => Rejected[reason="a candidate from the past"]
decide(FOR_THE_CANDIDATE, VoteRequest[term=OLDER, log=EVEN])     => Rejected[reason="a candidate from the past"]
decide(FOR_THE_CANDIDATE, VoteRequest[term=OLDER, log=AHEAD])    => Rejected[reason="a candidate from the past"]
decide(FOR_THE_CANDIDATE, VoteRequest[term=CURRENT, log=BEHIND]) => Rejected[reason="a log behind the voter's"]
decide(FOR_THE_CANDIDATE, VoteRequest[term=CURRENT, log=EVEN])   => Transition[next=FOR_THE_CANDIDATE, effects=[GRANT]]
decide(FOR_THE_CANDIDATE, VoteRequest[term=CURRENT, log=AHEAD])  => Transition[next=FOR_THE_CANDIDATE, effects=[GRANT]]
decide(FOR_THE_CANDIDATE, VoteRequest[term=NEWER, log=BEHIND])   => Rejected[reason="a log behind the voter's"]
decide(FOR_THE_CANDIDATE, VoteRequest[term=NEWER, log=EVEN])     => Transition[next=FOR_THE_CANDIDATE, effects=[GRANT]]
decide(FOR_THE_CANDIDATE, VoteRequest[term=NEWER, log=AHEAD])    => Transition[next=FOR_THE_CANDIDATE, effects=[GRANT]]
decide(FOR_THE_CANDIDATE, null)                                  => throws NullPointerException
decide(FOR_ANOTHER, VoteRequest[term=OLDER, log=BEHIND])         => Rejected[reason="a candidate from the past"]
decide(FOR_ANOTHER, VoteRequest[term=OLDER, log=EVEN])           => Rejected[reason="a candidate from the past"]
decide(FOR_ANOTHER, VoteRequest[term=OLDER, log=AHEAD])          => Rejected[reason="a candidate from the past"]
decide(FOR_ANOTHER, VoteRequest[term=CURRENT, log=BEHIND])       => Rejected[reason="one vote per term"]
decide(FOR_ANOTHER, VoteRequest[term=CURRENT, log=EVEN])         => Rejected[reason="one vote per term"]
decide(FOR_ANOTHER, VoteRequest[term=CURRENT, log=AHEAD])        => Rejected[reason="one vote per term"]
decide(FOR_ANOTHER, VoteRequest[term=NEWER, log=BEHIND])         => Rejected[reason="a log behind the voter's"]
decide(FOR_ANOTHER, VoteRequest[term=NEWER, log=EVEN])           => Transition[next=FOR_THE_CANDIDATE, effects=[GRANT]]
decide(FOR_ANOTHER, VoteRequest[term=NEWER, log=AHEAD])          => Transition[next=FOR_THE_CANDIDATE, effects=[GRANT]]
decide(FOR_ANOTHER, null)                                        => throws NullPointerException
decide(null, VoteRequest[term=OLDER, log=BEHIND])                => Rejected[reason="a candidate from the past"]
decide(null, VoteRequest[term=OLDER, log=EVEN])                  => Rejected[reason="a candidate from the past"]
decide(null, VoteRequest[term=OLDER, log=AHEAD])                 => Rejected[reason="a candidate from the past"]
decide(null, VoteRequest[term=CURRENT, log=BEHIND])              => Rejected[reason="a log behind the voter's"]
decide(null, VoteRequest[term=CURRENT, log=EVEN])                => Transition[next=FOR_THE_CANDIDATE, effects=[GRANT]]
decide(null, VoteRequest[term=CURRENT, log=AHEAD])               => Transition[next=FOR_THE_CANDIDATE, effects=[GRANT]]
decide(null, VoteRequest[term=NEWER, log=BEHIND])                => Rejected[reason="a log behind the voter's"]
decide(null, VoteRequest[term=NEWER, log=EVEN])                  => Transition[next=FOR_THE_CANDIDATE, effects=[GRANT]]
decide(null, VoteRequest[term=NEWER, log=AHEAD])                 => Transition[next=FOR_THE_CANDIDATE, effects=[GRANT]]
