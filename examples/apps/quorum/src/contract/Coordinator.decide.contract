decide(COLLECTING, Timeout[unanimousSoFar=false])          => Transition[next=ABORTED, effects=[SEND_ABORT]]
decide(COLLECTING, Timeout[unanimousSoFar=true])           => Transition[next=ABORTED, effects=[SEND_ABORT]]
decide(COLLECTING, null)                                   => throws NullPointerException
decide(COMMITTED, Tally[complete=false, unanimous=false])  => Unchanged[reason="already decided"]
decide(COMMITTED, Tally[complete=false, unanimous=true])   => Unchanged[reason="already decided"]
decide(COMMITTED, Tally[complete=true, unanimous=false])   => Unchanged[reason="already decided"]
decide(COMMITTED, Tally[complete=true, unanimous=true])    => Unchanged[reason="already decided"]
decide(COMMITTED, Timeout[unanimousSoFar=false])           => Unchanged[reason="already decided"]
decide(COMMITTED, Timeout[unanimousSoFar=true])            => Unchanged[reason="already decided"]
decide(COMMITTED, null)                                    => throws NullPointerException
decide(ABORTED, Tally[complete=false, unanimous=false])    => Unchanged[reason="already decided"]
decide(ABORTED, Tally[complete=false, unanimous=true])     => Unchanged[reason="already decided"]
decide(ABORTED, Tally[complete=true, unanimous=false])     => Unchanged[reason="already decided"]
decide(ABORTED, Tally[complete=true, unanimous=true])      => Unchanged[reason="already decided"]
decide(ABORTED, Timeout[unanimousSoFar=false])             => Unchanged[reason="already decided"]
decide(ABORTED, Timeout[unanimousSoFar=true])              => Unchanged[reason="already decided"]
decide(ABORTED, null)                                      => throws NullPointerException
decide(null, Tally[complete=false, unanimous=false])       => throws NullPointerException
decide(null, Tally[complete=false, unanimous=true])        => throws NullPointerException
decide(null, Tally[complete=true, unanimous=false])        => throws NullPointerException
decide(null, Tally[complete=true, unanimous=true])         => throws NullPointerException
decide(null, Timeout[unanimousSoFar=false])                => throws NullPointerException
