# Behavioural contract, generated by jvmcontract. Do not edit: regenerate it with `jvmcontract update`.
# It lists the outcome of every possible input, and the build checks it against the bytecode.
# A change here is a change in what the code does: review it like an API change.
target: net.terminalvalue.quorum.twopc.Participant#decide
domain: ParticipantState (5) × ParticipantEvent (8) = 40 cases

decide(WORKING, Prepare[able=false])       => Transition[next=ABORTED, effects=[VOTE_NO]]
decide(WORKING, Prepare[able=true])        => Transition[next=PREPARED, effects=[VOTE_YES]]
decide(WORKING, GiveUp[])                  => Transition[next=ABORTED, effects=[]]
decide(WORKING, Learned[outcome=NONE])     => Unchanged[reason="no decision yet"]
decide(WORKING, Learned[outcome=COMMIT])   => Transition[next=COMMITTED, effects=[]]
decide(WORKING, Learned[outcome=ABORT])    => Transition[next=ABORTED, effects=[]]
decide(WORKING, Restarted[])               => Transition[next=ABORTED, effects=[]]
decide(WORKING, null)                      => throws NullPointerException
decide(PREPARED, Prepare[able=false])      => Rejected[reason="already voted"]
decide(PREPARED, Prepare[able=true])       => Rejected[reason="already voted"]
decide(PREPARED, GiveUp[])                 => Rejected[reason="voted yes: holds its locks until the decision"]
decide(PREPARED, Learned[outcome=NONE])    => Unchanged[reason="no decision yet"]
decide(PREPARED, Learned[outcome=COMMIT])  => Transition[next=COMMITTED, effects=[]]
decide(PREPARED, Learned[outcome=ABORT])   => Transition[next=ABORTED, effects=[]]
decide(PREPARED, Restarted[])              => Unchanged[reason="holds its locks until the decision"]
decide(PREPARED, null)                     => throws NullPointerException
decide(COMMITTED, Prepare[able=false])     => Rejected[reason="already voted"]
decide(COMMITTED, Prepare[able=true])      => Rejected[reason="already voted"]
decide(COMMITTED, GiveUp[])                => Rejected[reason="already decided"]
decide(COMMITTED, Learned[outcome=NONE])   => Unchanged[reason="already decided"]
decide(COMMITTED, Learned[outcome=COMMIT]) => Unchanged[reason="already decided"]
decide(COMMITTED, Learned[outcome=ABORT])  => Unchanged[reason="already decided"]
decide(COMMITTED, Restarted[])             => Unchanged[reason="already decided"]
decide(COMMITTED, null)                    => throws NullPointerException
decide(ABORTED, Prepare[able=false])       => Rejected[reason="already voted"]
decide(ABORTED, Prepare[able=true])        => Rejected[reason="already voted"]
decide(ABORTED, GiveUp[])                  => Rejected[reason="already decided"]
decide(ABORTED, Learned[outcome=NONE])     => Unchanged[reason="already decided"]
decide(ABORTED, Learned[outcome=COMMIT])   => Unchanged[reason="already decided"]
decide(ABORTED, Learned[outcome=ABORT])    => Unchanged[reason="already decided"]
decide(ABORTED, Restarted[])               => Unchanged[reason="already decided"]
decide(ABORTED, null)                      => throws NullPointerException
decide(null, Prepare[able=false])          => throws NullPointerException
decide(null, Prepare[able=true])           => throws NullPointerException
decide(null, GiveUp[])                     => throws NullPointerException
decide(null, Learned[outcome=NONE])        => throws NullPointerException
decide(null, Learned[outcome=COMMIT])      => throws NullPointerException
decide(null, Learned[outcome=ABORT])       => throws NullPointerException
decide(null, Restarted[])                  => throws NullPointerException
decide(null, null)                         => throws NullPointerException
