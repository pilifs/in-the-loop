# Behavioural contract, generated by jvmcontract. Do not edit: regenerate it with `jvmcontract update`.
# It lists the outcome of every possible input, and the build checks it against the bytecode.
# A change here is a change in what the code does: review it like an API change.
target: net.terminalvalue.quorum.raft.CommitRule#decide
domain: EntryStatus (3) × Replication (7) = 21 cases

decide(PENDING, Replication[term=OLDER, majority=false])     => Unchanged[reason="an entry from an earlier term is committed only along with one of the current term"]
decide(PENDING, Replication[term=OLDER, majority=true])      => Unchanged[reason="an entry from an earlier term is committed only along with one of the current term"]
decide(PENDING, Replication[term=CURRENT, majority=false])   => Unchanged[reason="waiting for a majority"]
decide(PENDING, Replication[term=CURRENT, majority=true])    => Transition[next=COMMITTED, effects=[APPLY]]
decide(PENDING, Replication[term=NEWER, majority=false])     => throws IllegalStateException("an entry from a term after the leader's")
decide(PENDING, Replication[term=NEWER, majority=true])      => throws IllegalStateException("an entry from a term after the leader's")
decide(PENDING, null)                                        => throws NullPointerException
decide(COMMITTED, Replication[term=OLDER, majority=false])   => Unchanged[reason="already committed"]
decide(COMMITTED, Replication[term=OLDER, majority=true])    => Unchanged[reason="already committed"]
decide(COMMITTED, Replication[term=CURRENT, majority=false]) => Unchanged[reason="already committed"]
decide(COMMITTED, Replication[term=CURRENT, majority=true])  => Unchanged[reason="already committed"]
decide(COMMITTED, Replication[term=NEWER, majority=false])   => Unchanged[reason="already committed"]
decide(COMMITTED, Replication[term=NEWER, majority=true])    => Unchanged[reason="already committed"]
decide(COMMITTED, null)                                      => Unchanged[reason="already committed"]
decide(null, Replication[term=OLDER, majority=false])        => throws NullPointerException
decide(null, Replication[term=OLDER, majority=true])         => throws NullPointerException
decide(null, Replication[term=CURRENT, majority=false])      => throws NullPointerException
decide(null, Replication[term=CURRENT, majority=true])       => throws NullPointerException
decide(null, Replication[term=NEWER, majority=false])        => throws NullPointerException
decide(null, Replication[term=NEWER, majority=true])         => throws NullPointerException
decide(null, null)                                           => throws NullPointerException
