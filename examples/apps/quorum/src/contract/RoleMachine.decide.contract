# Behavioural contract, generated by jvmcontract. Do not edit: regenerate it with `jvmcontract update`.
# It lists the outcome of every possible input, and the build checks it against the bytecode.
# A change here is a change in what the code does: review it like an API change.
target: net.terminalvalue.quorum.raft.RoleMachine#decide
domain: Role (4) × RoleEvent (13) = 52 cases

decide(FOLLOWER, ElectionTimeout[])             => Transition[next=CANDIDATE, effects=[INCREMENT_TERM, VOTE_FOR_SELF, REQUEST_VOTES]]
decide(FOLLOWER, VotesCounted[majority=false])  => Unchanged[reason="votes of an election this server is no longer in"]
decide(FOLLOWER, VotesCounted[majority=true])   => Unchanged[reason="votes of an election this server is no longer in"]
decide(FOLLOWER, AppendEntries[term=OLDER])     => Rejected[reason="stale leader"]
decide(FOLLOWER, AppendEntries[term=CURRENT])   => Transition[next=FOLLOWER, effects=[RESET_ELECTION_TIMER]]
decide(FOLLOWER, AppendEntries[term=NEWER])     => Transition[next=FOLLOWER, effects=[ADOPT_TERM, RESET_ELECTION_TIMER]]
decide(FOLLOWER, RequestVote[term=OLDER])       => Unchanged[reason="the vote itself is decided by the vote rule"]
decide(FOLLOWER, RequestVote[term=CURRENT])     => Unchanged[reason="the vote itself is decided by the vote rule"]
decide(FOLLOWER, RequestVote[term=NEWER])       => Transition[next=FOLLOWER, effects=[ADOPT_TERM]]
decide(FOLLOWER, Response[term=OLDER])          => Unchanged[reason="a reply from the current or an older term changes no role"]
decide(FOLLOWER, Response[term=CURRENT])        => Unchanged[reason="a reply from the current or an older term changes no role"]
decide(FOLLOWER, Response[term=NEWER])          => Transition[next=FOLLOWER, effects=[ADOPT_TERM]]
decide(FOLLOWER, null)                          => throws NullPointerException
decide(CANDIDATE, ElectionTimeout[])            => Transition[next=CANDIDATE, effects=[INCREMENT_TERM, VOTE_FOR_SELF, REQUEST_VOTES]]
decide(CANDIDATE, VotesCounted[majority=false]) => Unchanged[reason="no majority yet"]
decide(CANDIDATE, VotesCounted[majority=true])  => Transition[next=LEADER, effects=[SEND_HEARTBEATS]]
decide(CANDIDATE, AppendEntries[term=OLDER])    => Rejected[reason="stale leader"]
decide(CANDIDATE, AppendEntries[term=CURRENT])  => Transition[next=FOLLOWER, effects=[RESET_ELECTION_TIMER]]
decide(CANDIDATE, AppendEntries[term=NEWER])    => Transition[next=FOLLOWER, effects=[ADOPT_TERM, RESET_ELECTION_TIMER]]
decide(CANDIDATE, RequestVote[term=OLDER])      => Unchanged[reason="the vote itself is decided by the vote rule"]
decide(CANDIDATE, RequestVote[term=CURRENT])    => Unchanged[reason="the vote itself is decided by the vote rule"]
decide(CANDIDATE, RequestVote[term=NEWER])      => Transition[next=FOLLOWER, effects=[ADOPT_TERM]]
decide(CANDIDATE, Response[term=OLDER])         => Unchanged[reason="a reply from the current or an older term changes no role"]
decide(CANDIDATE, Response[term=CURRENT])       => Unchanged[reason="a reply from the current or an older term changes no role"]
decide(CANDIDATE, Response[term=NEWER])         => Transition[next=FOLLOWER, effects=[ADOPT_TERM]]
decide(CANDIDATE, null)                         => throws NullPointerException
decide(LEADER, ElectionTimeout[])               => Unchanged[reason="a leader does not hold elections"]
decide(LEADER, VotesCounted[majority=false])    => Unchanged[reason="votes of an election this server is no longer in"]
decide(LEADER, VotesCounted[majority=true])     => Unchanged[reason="votes of an election this server is no longer in"]
decide(LEADER, AppendEntries[term=OLDER])       => Rejected[reason="stale leader"]
decide(LEADER, AppendEntries[term=CURRENT])     => throws IllegalStateException("two leaders in one term")
decide(LEADER, AppendEntries[term=NEWER])       => Transition[next=FOLLOWER, effects=[ADOPT_TERM, RESET_ELECTION_TIMER]]
decide(LEADER, RequestVote[term=OLDER])         => Unchanged[reason="the vote itself is decided by the vote rule"]
decide(LEADER, RequestVote[term=CURRENT])       => Unchanged[reason="the vote itself is decided by the vote rule"]
decide(LEADER, RequestVote[term=NEWER])         => Transition[next=FOLLOWER, effects=[ADOPT_TERM]]
decide(LEADER, Response[term=OLDER])            => Unchanged[reason="a reply from the current or an older term changes no role"]
decide(LEADER, Response[term=CURRENT])          => Unchanged[reason="a reply from the current or an older term changes no role"]
decide(LEADER, Response[term=NEWER])            => Transition[next=FOLLOWER, effects=[ADOPT_TERM]]
decide(LEADER, null)                            => throws NullPointerException
decide(null, ElectionTimeout[])                 => throws NullPointerException
decide(null, VotesCounted[majority=false])      => throws NullPointerException
decide(null, VotesCounted[majority=true])       => throws NullPointerException
decide(null, AppendEntries[term=OLDER])         => Rejected[reason="stale leader"]
decide(null, AppendEntries[term=CURRENT])       => throws NullPointerException
decide(null, AppendEntries[term=NEWER])         => Transition[next=FOLLOWER, effects=[ADOPT_TERM, RESET_ELECTION_TIMER]]
decide(null, RequestVote[term=OLDER])           => Unchanged[reason="the vote itself is decided by the vote rule"]
decide(null, RequestVote[term=CURRENT])         => Unchanged[reason="the vote itself is decided by the vote rule"]
decide(null, RequestVote[term=NEWER])           => Transition[next=FOLLOWER, effects=[ADOPT_TERM]]
decide(null, Response[term=OLDER])              => Unchanged[reason="a reply from the current or an older term changes no role"]
decide(null, Response[term=CURRENT])            => Unchanged[reason="a reply from the current or an older term changes no role"]
decide(null, Response[term=NEWER])              => Transition[next=FOLLOWER, effects=[ADOPT_TERM]]
