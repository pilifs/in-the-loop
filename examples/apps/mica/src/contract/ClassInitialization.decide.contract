decide(IN_PROGRESS, Request[byInitializingThread=true])    => Transition[next=IN_PROGRESS, effects=[PROCEED]]
decide(IN_PROGRESS, Completed[])                           => Transition[next=INITIALIZED, effects=[NOTIFY_ALL]]
