decide(IN_PROGRESS, Failed[error=true])                    => Transition[next=ERRONEOUS, effects=[NOTIFY_ALL, RETHROW]]
decide(IN_PROGRESS, null)                                  => throws NullPointerException
decide(INITIALIZED, Request[byInitializingThread=false])   => Transition[next=INITIALIZED, effects=[PROCEED]]
decide(INITIALIZED, Request[byInitializingThread=true])    => Transition[next=INITIALIZED, effects=[PROCEED]]
decide(INITIALIZED, Completed[])                           => Rejected[reason="no initialization is in progress"]
decide(INITIALIZED, Failed[error=false])                   => Rejected[reason="no initialization is in progress"]
decide(INITIALIZED, Failed[error=true])                    => Rejected[reason="no initialization is in progress"]
decide(INITIALIZED, null)                                  => throws NullPointerException
decide(ERRONEOUS, Request[byInitializingThread=false])     => Transition[next=ERRONEOUS, effects=[THROW_NO_CLASS_DEF_FOUND_ERROR]]
decide(ERRONEOUS, Request[byInitializingThread=true])      => Transition[next=ERRONEOUS, effects=[THROW_NO_CLASS_DEF_FOUND_ERROR]]
decide(ERRONEOUS, Completed[])                             => Rejected[reason="no initialization is in progress"]
decide(ERRONEOUS, Failed[error=false])                     => Rejected[reason="no initialization is in progress"]
decide(ERRONEOUS, Failed[error=true])                      => Rejected[reason="no initialization is in progress"]
decide(ERRONEOUS, null)                                    => throws NullPointerException
