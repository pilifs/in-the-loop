{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "jvmcontract",
          "version": "0.1.0",
          "rules": [
            {
              "id": "behaviour-changed",
              "shortDescription": {
                "text": "The code no longer matches its behavioural contract."
              }
            },
            {
              "id": "unverifiable",
              "shortDescription": {
                "text": "The method cannot be verified: it is not pure, or its inputs are not finite."
              }
            },
            {
              "id": "capability-changed",
              "shortDescription": {
                "text": "The module's bytecode reaches a capability, or a library, that its contract does not list."
              }
            },
            {
              "id": "api-changed",
              "shortDescription": {
                "text": "The module's public API differs from its contract."
              }
            },
            {
              "id": "boundaries-changed",
              "shortDescription": {
                "text": "The module's boundaries (routes, listeners, schedules, bean definitions, the advice on them, or a problem with that advice) differ from their contract."
              }
            },
            {
              "id": "property-violated",
              "shortDescription": {
                "text": "An input exists on which the method violates its stated property."
              }
            },
            {
              "id": "invariant-violated",
              "shortDescription": {
                "text": "The model checker found a behaviour of the model that violates an invariant."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "boundaries-changed",
          "level": "error",
          "message": {
            "text": "Boundaries of module ticketing-service differ from their contract:\n  added net.terminalvalue.boxoffice.ticketing.api.HoldController: GET /holds/{holdId} => Hold get(@PathVariable String id)\n  added net.terminalvalue.boxoffice.ticketing.api.HoldController: GET /holds/{holdId} => Hold get(@PathVariable String id): ! @PathVariable id matches no variable in /holds/{holdId}: MissingPathVariableException, a 500 on every request\n  added net.terminalvalue.boxoffice.ticketing.api.HoldController: GET /holds/{holdId} => Hold get(@PathVariable String id): reads HoldDocument\n  added net.terminalvalue.boxoffice.ticketing.api.HoldController: GET /holds/{holdId} => Hold get(@PathVariable String id): throws NotFoundException (404 by ApiErrors.notFound)\n  removed net.terminalvalue.boxoffice.ticketing.api.HoldController: GET /holds/{id} => Hold get(@PathVariable String id)\n  removed net.terminalvalue.boxoffice.ticketing.api.HoldController: GET /holds/{id} => Hold get(@PathVariable String id): reads HoldDocument\n  removed net.terminalvalue.boxoffice.ticketing.api.HoldController: GET /holds/{id} => Hold get(@PathVariable String id): throws NotFoundException (404 by ApiErrors.notFound)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/apps/boxoffice/ticketing-service/src/main/java/net/terminalvalue/boxoffice/ticketing/api/HoldController.java"
                },
                "region": {
                  "startLine": 20
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
