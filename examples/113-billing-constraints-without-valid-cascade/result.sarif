{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "jvmcontract",
          "version": "0.1.0",
          "rules": [
            {
              "id": "behaviour-changed",
              "shortDescription": {
                "text": "The code no longer matches its behavioural contract."
              }
            },
            {
              "id": "unverifiable",
              "shortDescription": {
                "text": "The method cannot be verified: it is not pure, or its inputs are not finite."
              }
            },
            {
              "id": "capability-changed",
              "shortDescription": {
                "text": "The module's bytecode reaches a capability, or a library, that its contract does not list."
              }
            },
            {
              "id": "api-changed",
              "shortDescription": {
                "text": "The module's public API differs from its contract."
              }
            },
            {
              "id": "boundaries-changed",
              "shortDescription": {
                "text": "The module's boundaries (routes, listeners, schedules, bean definitions, the advice on them, or a problem with that advice) differ from their contract."
              }
            },
            {
              "id": "property-violated",
              "shortDescription": {
                "text": "An input exists on which the method violates its stated property."
              }
            },
            {
              "id": "invariant-violated",
              "shortDescription": {
                "text": "The model checker found a behaviour of the model that violates an invariant."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "boundaries-changed",
          "level": "error",
          "message": {
            "text": "Boundaries of module ticketing-service differ from their contract:\n  added configuration: boxoffice.outbox.batch-size: int, default 100\n  added configuration: boxoffice.outbox.batch-size: int, default 100: @Value in MessagingConfiguration.outboxRelay(MongoTemplate, KafkaTemplate, Clock, int), batchSize, default 100\n  added configuration: boxoffice.outbox.poll-interval: Duration = 100ms\n  added configuration: boxoffice.outbox.poll-interval: Duration = 100ms: @Scheduled in OutboxRelay.publishPending(), default 100ms\n  added net.terminalvalue.boxoffice.ticketing.TicketingApplication: @Bean => HoldPolicy holdPolicy(@Value(\"${boxoffice.hold.max-seats:8}\") int maxSeats, @Value(\"${boxoffice.hold.ttl:2m}\") Duration ttl): throws IllegalArgumentException\n  added net.terminalvalue.boxoffice.ticketing.api.ConcertController: POST /concerts => ResponseEntity<Concert> create(@Valid @RequestBody CreateConcert request): throws IllegalStateException (500), NotFoundException (404 by ApiErrors.notFound)\n  added net.terminalvalue.boxoffice.ticketing.api.ConcertController: POST /concerts/{id}/holds => ResponseEntity<Hold> hold(@PathVariable String id, @RequestHeader(name = \"Idempotency-Key\", required = false) String idempotencyKey, @Valid @RequestBody HoldSeats request): throws ConflictException (409 by ApiErrors.conflict), IllegalArgumentException (500), IllegalStateException (500), InvalidRequestException (400 by ApiErrors.invalid), NotFoundException (404 by ApiErrors.notFound)\n  added net.terminalvalue.boxoffice.ticketing.api.OrderController: POST /orders => ResponseEntity<Order> place(@Valid @RequestBody PlaceOrder request): throws ConflictException (409 by ApiErrors.conflict), IllegalStateException (500), NotFoundException (404 by ApiErrors.notFound)\n  added net.terminalvalue.boxoffice.ticketing.api.OrderController: POST /orders => ResponseEntity<Order> place(@Valid @RequestBody PlaceOrder request): writes OrderDocument, Outbox.Entry\n  added net.terminalvalue.boxoffice.ticketing.api.OrderController: POST /orders/{id}/cancellation => ResponseEntity<Order> cancel(@PathVariable String id): writes OrderDocument, Outbox.Entry, SeatDocument\n  added net.terminalvalue.boxoffice.ticketing.events.PaymentEventListener: @KafkaListener(topics = \"payments.events\", groupId = \"ticketing\") => void on(ConsumerRecord<String, String> record): reads Inbox.Entry, OrderDocument, SeatDocument\n  added net.terminalvalue.boxoffice.ticketing.events.PaymentEventListener: @KafkaListener(topics = \"payments.events\", groupId = \"ticketing\") => void on(ConsumerRecord<String, String> record): writes Inbox.Entry, OrderDocument, Outbox.Entry, SeatDocument\n  added wire net.terminalvalue.boxoffice.ticketing.domain.OrderStatus: CONFIRMED\n  added wire net.terminalvalue.boxoffice.ticketing.domain.OrderStatus: DECLINED\n  added wire net.terminalvalue.boxoffice.ticketing.domain.OrderStatus: PENDING_PAYMENT\n  added wire net.terminalvalue.boxoffice.ticketing.domain.OrderStatus: REFUNDED\n  added wire net.terminalvalue.boxoffice.ticketing.domain.OrderStatus: REFUND_PENDING\n  added wire net.terminalvalue.boxoffice.ticketing.domain.OrderStatus: enum\n  added wire net.terminalvalue.boxoffice.ticketing.domain.SeatStatus: AVAILABLE\n  added wire net.terminalvalue.boxoffice.ticketing.domain.SeatStatus: HELD\n  added wire net.terminalvalue.boxoffice.ticketing.domain.SeatStatus: SOLD\n  added wire net.terminalvalue.boxoffice.ticketing.domain.SeatStatus: enum\n  removed configuration: boxoffice.outbox.poll-interval = 100ms\n  removed configuration: boxoffice.outbox.poll-interval = 100ms: ! nothing binds it: no class on the class path reads it and no configuration metadata declares it\n  removed net.terminalvalue.boxoffice.ticketing.api.ConcertController: POST /concerts => ResponseEntity<Concert> create(@Valid @RequestBody CreateConcert request): throws NotFoundException (404 by ApiErrors.notFound)\n  removed net.terminalvalue.boxoffice.ticketing.api.ConcertController: POST /concerts/{id}/holds => ResponseEntity<Hold> hold(@PathVariable String id, @RequestHeader(name = \"Idempotency-Key\", required = false) String idempotencyKey, @Valid @RequestBody HoldSeats request): throws ConflictException (409 by ApiErrors.conflict), InvalidRequestException (400 by ApiErrors.invalid), NotFoundException (404 by ApiErrors.notFound)\n  removed net.terminalvalue.boxoffice.ticketing.api.OrderController: POST /orders => ResponseEntity<Order> place(@Valid @RequestBody PlaceOrder request): throws ConflictException (409 by ApiErrors.conflict), NotFoundException (404 by ApiErrors.notFound)\n  removed net.terminalvalue.boxoffice.ticketing.api.OrderController: POST /orders => ResponseEntity<Order> place(@Valid @RequestBody PlaceOrder request): writes OrderDocument\n  removed net.terminalvalue.boxoffice.ticketing.api.OrderController: POST /orders/{id}/cancellation => ResponseEntity<Order> cancel(@PathVariable String id): writes OrderDocument, SeatDocument\n  removed net.terminalvalue.boxoffice.ticketing.events.PaymentEventListener: @KafkaListener(topics = \"payments.events\", groupId = \"ticketing\") => void on(ConsumerRecord<String, String> record): reads OrderDocument, SeatDocument\n  removed net.terminalvalue.boxoffice.ticketing.events.PaymentEventListener: @KafkaListener(topics = \"payments.events\", groupId = \"ticketing\") => void on(ConsumerRecord<String, String> record): writes OrderDocument, SeatDocument"
          }
        }
      ]
    }
  ]
}
