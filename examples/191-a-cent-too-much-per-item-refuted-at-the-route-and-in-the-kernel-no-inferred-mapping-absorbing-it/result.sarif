{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "jvmcontract",
          "version": "0.1.0",
          "rules": [
            {
              "id": "behaviour-changed",
              "shortDescription": {
                "text": "The code no longer matches its behavioural contract."
              }
            },
            {
              "id": "unverifiable",
              "shortDescription": {
                "text": "The method cannot be verified: it is not pure, or its inputs are not finite."
              }
            },
            {
              "id": "capability-changed",
              "shortDescription": {
                "text": "The module's bytecode reaches a capability, or a library, that its contract does not list."
              }
            },
            {
              "id": "api-changed",
              "shortDescription": {
                "text": "The module's public API differs from its contract."
              }
            },
            {
              "id": "boundaries-changed",
              "shortDescription": {
                "text": "The module's boundaries (routes, listeners, schedules, bean definitions, the advice on them, or a problem with that advice) differ from their contract."
              }
            },
            {
              "id": "property-violated",
              "shortDescription": {
                "text": "An input exists on which the method violates its stated property."
              }
            },
            {
              "id": "invariant-violated",
              "shortDescription": {
                "text": "The model checker found a behaviour of the model that violates an invariant."
              }
            },
            {
              "id": "effects-changed",
              "shortDescription": {
                "text": "An input exists on which an entry point's ordered trace of modeled boundary-call attempts, its response or its outcome differs between two builds."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "effects-changed",
          "level": "error",
          "message": {
            "text": "POST /quotes no longer preserves its trace of modeled boundary calls: POST /quotes on cents=0, quantity=1: the old build returns 0 and attempts no modeled call; the new one returns 1 and attempts KafkaTemplate.send(topic=\"quotes\", data.total=1, data.quantity=1). Replayed on a JVM (JDK 25.0.5) under the modeled dependencies (generated stubs for KafkaTemplate.send, each returning normally), not against real infrastructure"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/apps/shop/src/main/java/shop/QuotesController.java"
                },
                "region": {
                  "startLine": 19
                }
              }
            }
          ]
        },
        {
          "ruleId": "behaviour-changed",
          "level": "error",
          "message": {
            "text": "shop.Pricing#total no longer preserves what shop.Pricing#total did under the correspondence alignment proposed: total(q=new Quote(new Money(0), 1)): before, 0; after, 1"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/apps/shop/src/main/java/shop/Pricing.java"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
