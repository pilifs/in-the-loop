{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "jvmcontract",
          "version": "0.1.0",
          "rules": [
            {
              "id": "behaviour-changed",
              "shortDescription": {
                "text": "The code no longer matches its behavioural contract."
              }
            },
            {
              "id": "unverifiable",
              "shortDescription": {
                "text": "The method cannot be verified: it is not pure, or its inputs are not finite."
              }
            },
            {
              "id": "capability-changed",
              "shortDescription": {
                "text": "The module's bytecode reaches a capability, or a library, that its contract does not list."
              }
            },
            {
              "id": "api-changed",
              "shortDescription": {
                "text": "The module's public API differs from its contract."
              }
            },
            {
              "id": "boundaries-changed",
              "shortDescription": {
                "text": "The module's boundaries (routes, listeners, schedules, bean definitions, the advice on them, or a problem with that advice) differ from their contract."
              }
            },
            {
              "id": "property-violated",
              "shortDescription": {
                "text": "An input exists on which the method violates its stated property."
              }
            },
            {
              "id": "invariant-violated",
              "shortDescription": {
                "text": "The model checker found a behaviour of the model that violates an invariant."
              }
            },
            {
              "id": "effects-changed",
              "shortDescription": {
                "text": "An input exists on which an entry point's ordered trace of modeled boundary-call attempts, its response or its outcome differs between two builds."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "effects-changed",
          "level": "error",
          "message": {
            "text": "POST /deliveries/failures no longer preserves its trace of modeled boundary calls: POST /deliveries/failures on status=0, idempotent=false, attempts=5: the old build returns 200 and attempts KafkaTemplate.send(topic=\"delivery-dead-letters\", data.status=0, data.attempts=5, data.attempt=absent, data.class=net.terminalvalue.deliveries.DeadLettered); the new one returns 200 and attempts KafkaTemplate.send(topic=\"delivery-dead-letters\", data.status=0, data.attempts=5, data.attempt=absent, data.class=net.terminalvalue.deliveries.DeadLettered), then KafkaTemplate.send(topic=\"delivery-dead-letters\", data.status=0, data.attempts=5, data.attempt=absent, data.class=net.terminalvalue.deliveries.DeadLettered). Replayed on a JVM (JDK 25.0.5) under the modeled dependencies (recording stubs for KafkaTemplate.send, each returning normally), not against real infrastructure"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/apps/deliveries/src/main/java/net/terminalvalue/deliveries/DeliveryFailures.java"
                },
                "region": {
                  "startLine": 29
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
