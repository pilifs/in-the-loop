; VC 3
(push 1)
(assert (and (and (bvsle #x00000000 length) (and (bvsle #x00000000 cursor) (bvsle cursor length) (= heap initial) (=> (and (bvsle #x00000000 k) (bvslt k cursor)) (distinct (select heap k) target))) (not (bvsge cursor length))) (not (and (bvsle #x00000000 cursor) (bvslt cursor length)))))
(check-sat)
(pop 1)
; VC 4
(push 1)
(assert (and (and (bvsle #x00000000 length) (and (bvsle #x00000000 cursor) (bvsle cursor length) (= heap initial) (=> (and (bvsle #x00000000 k) (bvslt k cursor)) (distinct (select heap k) target))) (bvsge cursor length)) (not (or (and (= #xffffffff #xffffffff) (=> (and (bvsle #x00000000 k) (bvslt k length)) (distinct (select initial k) target))) (and (and (bvsle #x00000000 #xffffffff) (bvslt #xffffffff length)) (= (select initial #xffffffff) target) (=> (and (bvsle #x00000000 k) (bvslt k #xffffffff)) (distinct (select initial k) target)))))))
(check-sat)
(pop 1)
; VC 5
(push 1)
(assert (and (and (bvsle #x00000000 length) (and (bvsle #x00000000 cursor) (bvsle cursor length) (= heap initial) (=> (and (bvsle #x00000000 k) (bvslt k cursor)) (distinct (select heap k) target))) (bvsge cursor length)) (not (= heap initial))))
(check-sat)
(pop 1)
; VC 6
(push 1)
(assert (and (and (bvsle #x00000000 length) (and (bvsle #x00000000 cursor) (bvsle cursor length) (= heap initial) (=> (and (bvsle #x00000000 k) (bvslt k cursor)) (distinct (select heap k) target))) (not (bvsge cursor length)) (distinct (select heap cursor) target)) (not (and (bvsle #x00000000 (bvadd cursor #x00000001)) (bvsle (bvadd cursor #x00000001) length) (= heap initial) (=> (and (bvsle #x00000000 k) (bvslt k (bvadd cursor #x00000001))) (distinct (select heap k) target))))))
(check-sat)
(pop 1)
; VC 7
(push 1)
(assert (and (and (bvsle #x00000000 length) (and (bvsle #x00000000 cursor) (bvsle cursor length) (= heap initial) (=> (and (bvsle #x00000000 k) (bvslt k cursor)) (distinct (select heap k) target))) (not (bvsge cursor length)) (distinct (select heap cursor) target)) (not (and (bvsle #x00000000 (bvsub length (bvadd cursor #x00000001))) (bvslt (bvsub length (bvadd cursor #x00000001)) (bvsub length cursor)) (bvsle #x00000000 (bvsub length cursor))))))
(check-sat)
(pop 1)
; VC 8
(push 1)
(assert (and (and (bvsle #x00000000 length) (and (bvsle #x00000000 cursor) (bvsle cursor length) (= heap initial) (=> (and (bvsle #x00000000 k) (bvslt k cursor)) (distinct (select heap k) target))) (not (bvsge cursor length)) (not (distinct (select heap cursor) target))) (not (or (and (= cursor #xffffffff) (=> (and (bvsle #x00000000 k) (bvslt k length)) (distinct (select initial k) target))) (and (and (bvsle #x00000000 cursor) (bvslt cursor length)) (= (select initial cursor) target) (=> (and (bvsle #x00000000 k) (bvslt k cursor)) (distinct (select initial k) target)))))))
(check-sat)
