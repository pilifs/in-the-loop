; VC 0
(push 1)
(assert (bvsle #x00000000 length))
(check-sat)
(pop 1)
; VC 1
(push 1)
(assert (and (bvsle #x00000000 length) (= length #x7fffffff)))
(check-sat)
(pop 1)
; VC 2
(push 1)
(assert (and (bvsle #x00000000 length) (not (and (bvsle #x00000000 #x00000000) (bvsle #x00000000 length) (= initial initial) (=> (and (bvsle #x00000000 k) (bvslt k #x00000000)) (distinct (select initial k) target))))))
