; VC 9
(push 1)
(assert (and (and (bvsle #x00000000 length) (and (bvsle #x00000000 cursor) (bvsle cursor length) (= heap initial) (=> (and (bvsle #x00000000 k) (bvslt k cursor)) (distinct (select heap k) target))) (not (bvsge cursor length)) (not (distinct (select heap cursor) target))) (not (= heap initial))))
