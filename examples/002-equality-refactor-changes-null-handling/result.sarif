{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "contract-verifier",
          "rules": [
            {
              "id": "behaviour-changed",
              "shortDescription": {
                "text": "The code no longer matches its behavioural contract."
              }
            },
            {
              "id": "unverifiable",
              "shortDescription": {
                "text": "The method cannot be verified: it is not pure, or its inputs are not finite."
              }
            },
            {
              "id": "capability-changed",
              "shortDescription": {
                "text": "The module's bytecode reaches a capability, or a library, that its contract does not list."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "behaviour-changed",
          "level": "error",
          "message": {
            "text": "Behaviour of net.terminalvalue.boxoffice.ticketing.domain.OrderLifecycle#decide differs from its contract in 1 of 36 cases:\n  decide(null, PaymentRefunded[])\n    contract: throws NullPointerException\n    actual:   Unchanged[reason=\"no refund outstanding\"]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/apps/boxoffice/ticketing-domain/src/main/java/net/terminalvalue/boxoffice/ticketing/domain/OrderLifecycle.java"
                },
                "region": {
                  "startLine": 34
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
