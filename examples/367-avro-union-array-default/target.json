{
  "$schema": "../schema/target.schema.json",
  "schema": "example-target/v1",
  "identity": {
    "case": "avro-union-array-default",
    "family": "avro",
    "role": "calibration",
    "sourceConfidence": "checked-upstream"
  },
  "history": {
    "repository": "https://github.com/apache/avro",
    "revisions": {
      "parent": {
        "commit": "974961d97a84d3601113d0f3cdc41db6580d1b6b"
      },
      "fix": {
        "commit": "892d6997dcb65627560b04bd76c5a3dd97666cdf",
        "parent": "974961d97a84d3601113d0f3cdc41db6580d1b6b"
      }
    },
    "pairs": [
      {
        "name": "fixed",
        "kind": "exact-fix",
        "before": "parent",
        "after": "fix"
      }
    ],
    "introduction": {
      "status": "unknown"
    }
  },
  "preparation": {
    "route": "upstream-build",
    "jdks": [
      "21"
    ],
    "adapters": [
      "adapter/campaign/DefaultReader.java"
    ],
    "build": {
      "tool": "maven",
      "argv": [
        "mvn",
        "--batch-mode",
        "--no-transfer-progress",
        "-Dmaven.javadoc.skip=true",
        "-Drat.skip=true",
        "-Dcheckstyle.skip=true",
        "-Dspotless.skip=true",
        "-Dspotbugs.skip=true",
        "-Dgpg.skip=true",
        "-Dinvoker.skip=true",
        "-f",
        "lang/java/avro/pom.xml",
        "-Dmaven.test.skip=true",
        "install"
      ],
      "jdk": "21"
    }
  },
  "tasks": [
    {
      "id": "replay",
      "kind": "replay",
      "relation": "calibration",
      "pair": "fixed",
      "target": "org.apache.avro.generic.GenericDatumReader#read(Ljava/lang/Object;Lorg/apache/avro/io/Decoder;)Ljava/lang/Object;"
    },
    {
      "id": "union-parent",
      "kind": "prove",
      "relation": "calibration",
      "target": "org.apache.avro.generic.GenericDatumReader#read(Ljava/lang/Object;Lorg/apache/avro/io/Decoder;)Ljava/lang/Object;",
      "claim": "claims/union.json",
      "engine": "native",
      "gaps": "strict",
      "requires": [
        "replay"
      ],
      "expected": "refuted",
      "revision": "parent"
    },
    {
      "id": "union-fix",
      "kind": "prove",
      "relation": "calibration",
      "target": "org.apache.avro.generic.GenericDatumReader#read(Ljava/lang/Object;Lorg/apache/avro/io/Decoder;)Ljava/lang/Object;",
      "claim": "claims/union.json",
      "engine": "native",
      "gaps": "strict",
      "requires": [
        "replay"
      ],
      "expected": "established",
      "revision": "fix"
    },
    {
      "id": "direct-parent",
      "kind": "prove",
      "relation": "preservation",
      "target": "org.apache.avro.generic.GenericDatumReader#read(Ljava/lang/Object;Lorg/apache/avro/io/Decoder;)Ljava/lang/Object;",
      "claim": "claims/direct.json",
      "engine": "native",
      "gaps": "strict",
      "requires": [
        "replay"
      ],
      "expected": "established",
      "revision": "parent"
    },
    {
      "id": "direct-fix",
      "kind": "prove",
      "relation": "preservation",
      "target": "org.apache.avro.generic.GenericDatumReader#read(Ljava/lang/Object;Lorg/apache/avro/io/Decoder;)Ljava/lang/Object;",
      "claim": "claims/direct.json",
      "engine": "native",
      "gaps": "strict",
      "requires": [
        "replay"
      ],
      "expected": "established",
      "revision": "fix"
    }
  ],
  "controls": [
    {
      "id": "driver",
      "kind": "driver",
      "path": "driver/campaign/Cases.java"
    },
    {
      "id": "finite-oracle",
      "kind": "oracle",
      "path": "controls/table.json"
    }
  ]
}
