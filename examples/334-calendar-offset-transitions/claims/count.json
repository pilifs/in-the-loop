{
  "$schema": "../../schema/target-claim.schema.json",
  "schema": "example-target-claim/v1",
  "kind": "property",
  "property": "count",
  "statement": "The number of valid offsets distinguishes ordinary, skipped and repeated local times.",
  "assume": "code >= 0 && code < 24",
  "observations": [
    "result",
    "exception"
  ],
  "bounds": {
    "unwind": 32,
    "maxArrayLength": 24
  },
  "assert": "result == (code < 12 ? 1 : ((code / 2) % 6) == 1 ? 0 : ((code / 2) % 6) == 4 ? 2 : 1)"
}
