{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "jvmcontract",
          "version": "0.1.0",
          "rules": [
            {
              "id": "behaviour-changed",
              "shortDescription": {
                "text": "The code no longer matches its behavioural contract."
              }
            },
            {
              "id": "unverifiable",
              "shortDescription": {
                "text": "The method cannot be verified: it is not pure, or its inputs are not finite."
              }
            },
            {
              "id": "capability-changed",
              "shortDescription": {
                "text": "The module's bytecode reaches a capability, or a library, that its contract does not list."
              }
            },
            {
              "id": "api-changed",
              "shortDescription": {
                "text": "The module's public API differs from its contract."
              }
            },
            {
              "id": "boundaries-changed",
              "shortDescription": {
                "text": "The module's boundaries (routes, listeners, schedules, bean definitions, the advice on them, or a problem with that advice) differ from their contract."
              }
            },
            {
              "id": "property-violated",
              "shortDescription": {
                "text": "An input exists on which the method violates its stated property."
              }
            },
            {
              "id": "invariant-violated",
              "shortDescription": {
                "text": "The model checker found a behaviour of the model that violates an invariant."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "boundaries-changed",
          "level": "error",
          "message": {
            "text": "Boundaries of module ticketing-service differ from their contract:\n  added stored net.terminalvalue.boxoffice.ticketing.store.HoldDocument: ! TicketingStore(MongoTemplate) indexes \"idempotencyKey\": not a field of HoldDocument, OrderDocument or SeatDocument, so the index is on a field that is never set\n  added stored net.terminalvalue.boxoffice.ticketing.store.HoldDocument: ! TicketingStore(MongoTemplate) queries \"idempotencyKey\": not a field of HoldDocument, OrderDocument or SeatDocument, so the condition tests a field that is never set\n  added stored net.terminalvalue.boxoffice.ticketing.store.HoldDocument: ! TicketingStore.holdByIdempotencyKey(String, String) queries \"idempotencyKey\": not a field of HoldDocument, so the condition tests a field that is never set\n  added stored net.terminalvalue.boxoffice.ticketing.store.HoldDocument: requestKey: String\n  removed stored net.terminalvalue.boxoffice.ticketing.store.HoldDocument: idempotencyKey: String"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/apps/boxoffice/ticketing-service/src/main/java/net/terminalvalue/boxoffice/ticketing/store/TicketingStore.java"
                },
                "region": {
                  "startLine": 37
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
