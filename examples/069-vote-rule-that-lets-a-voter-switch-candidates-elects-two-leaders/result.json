  "before": {
    "file": "examples/apps/quorum/src/main/java/net/terminalvalue/quorum/raft/VoteRule.java",
    "startLine": 31,
    "code": "\n/**\n * The vote rule proper: a candidate from the past is refused; a newer term is a new vote, and in the current\n * term the vote is one per server, which the same candidate may collect again; and a candidate whose log is\n * behind the voter's is refused whatever its term.\n */\npublic static Decision<Ballot, VoteEffect> decide(Ballot ballot, VoteRequest request) {\n    if (request.term() == OLDER) {\n        return rejected(\"a candidate from the past\");\n    }\n    if (request.term() == CURRENT && ballot == Ballot.FOR_ANOTHER) {\n        return rejected(\"one vote per term\");\n    }\n    if (request.log() == BEHIND) {\n        return rejected(\"a log behind the voter's\");\n    }\n"
  },
  "after": {
    "file": "examples/apps/quorum/src/main/java/net/terminalvalue/quorum/raft/VoteRule.java",
    "startLine": 31,
    "code": "\n/**\n * The vote rule proper: a candidate from the past is refused; a newer term is a new vote, and in the current\n * term the vote goes to the candidate asking; and a candidate whose log is behind the voter's is refused\n * whatever its term.\n */\npublic static Decision<Ballot, VoteEffect> decide(Ballot ballot, VoteRequest request) {\n    if (request.term() == OLDER) {\n        return rejected(\"a candidate from the past\");\n    }\n    // A candidate still asking in the voter's term is one whose election the term has not settled: the vote\n    // this server cast went to a candidate that has not won, or its heartbeats would have arrived by now. So\n    // the vote goes to whoever is asking, and a split vote resolves within the term instead of costing a new one.\n    if (request.log() == BEHIND) {\n        return rejected(\"a log behind the voter's\");\n    }\n"
  },
