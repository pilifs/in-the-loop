    {"id": 13, "input": {"delimiter": "||", "source": "a||\"b||c\"||d||||f", "controlDelimiter": ",", "controlSource": "a,\"b,c\""}, "expected": {"fields": [["a", "b||c", "d", "", "f"]], "prefixes": [["a", "b,c"]]}}
