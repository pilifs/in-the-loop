    {"id": 8, "input": {"delimiter": "|~|", "source": "a|~|b|~|c", "controlDelimiter": "|||", "controlSource": "a|b"}, "expected": {"fields": [["a", "b", "c"]], "prefixes": [["a|b"]]}},
