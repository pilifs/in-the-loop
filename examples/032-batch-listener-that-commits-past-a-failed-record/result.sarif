{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "jvmcontract",
          "version": "0.1.0",
          "rules": [
            {
              "id": "behaviour-changed",
              "shortDescription": {
                "text": "The code no longer matches its behavioural contract."
              }
            },
            {
              "id": "unverifiable",
              "shortDescription": {
                "text": "The method cannot be verified: it is not pure, or its inputs are not finite."
              }
            },
            {
              "id": "capability-changed",
              "shortDescription": {
                "text": "The module's bytecode reaches a capability, or a library, that its contract does not list."
              }
            },
            {
              "id": "api-changed",
              "shortDescription": {
                "text": "The module's public API differs from its contract."
              }
            },
            {
              "id": "property-violated",
              "shortDescription": {
                "text": "An input exists on which the method violates its stated property."
              }
            },
            {
              "id": "invariant-violated",
              "shortDescription": {
                "text": "The model checker found a behaviour of the model that violates an invariant."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "property-violated",
          "level": "error",
          "message": {
            "text": "Property of net.terminalvalue.crosscut.kafka.BatchCommit#offsetToCommit violated: `result >= batchStart && result <= batchStart + batchSize && (failedIndex == -1 ? result == batchStart + batchSize : result == batchStart + failedIndex)` where batchStart >= 0 && batchStart <= 4611686018427387903L && batchSize > 0 && batchSize <= 100000 && failedIndex >= -1 && failedIndex < batchSize:\n  offsetToCommit(batchStart=0, batchSize=1, failedIndex=0)\n    outcome: 1"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/apps/crosscut/src/main/java/net/terminalvalue/crosscut/kafka/BatchCommit.java"
                },
                "region": {
                  "startLine": 21
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
