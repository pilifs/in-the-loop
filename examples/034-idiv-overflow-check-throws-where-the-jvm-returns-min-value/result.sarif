{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "jvmcontract",
          "version": "0.1.0",
          "rules": [
            {
              "id": "behaviour-changed",
              "shortDescription": {
                "text": "The code no longer matches its behavioural contract."
              }
            },
            {
              "id": "unverifiable",
              "shortDescription": {
                "text": "The method cannot be verified: it is not pure, or its inputs are not finite."
              }
            },
            {
              "id": "capability-changed",
              "shortDescription": {
                "text": "The module's bytecode reaches a capability, or a library, that its contract does not list."
              }
            },
            {
              "id": "api-changed",
              "shortDescription": {
                "text": "The module's public API differs from its contract."
              }
            },
            {
              "id": "property-violated",
              "shortDescription": {
                "text": "An input exists on which the method violates its stated property."
              }
            },
            {
              "id": "invariant-violated",
              "shortDescription": {
                "text": "The model checker found a behaviour of the model that violates an invariant."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "property-violated",
          "level": "error",
          "message": {
            "text": "Property of net.terminalvalue.mica.interp.Arithmetic#idiv violated: `(divisor != -1 || result == -dividend) && (divisor != 1 || result == dividend)` where divisor != 0:\n  idiv(dividend=-2147483648, divisor=-1)\n    outcome: throws ArithmeticException(\"integer overflow\")"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/apps/mica/src/main/java/net/terminalvalue/mica/interp/Arithmetic.java"
                },
                "region": {
                  "startLine": 18
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
