{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "jvmcontract",
          "version": "0.1.0",
          "rules": [
            {
              "id": "behaviour-changed",
              "shortDescription": {
                "text": "The code no longer matches its behavioural contract."
              }
            },
            {
              "id": "unverifiable",
              "shortDescription": {
                "text": "The method cannot be verified: it is not pure, or its inputs are not finite."
              }
            },
            {
              "id": "capability-changed",
              "shortDescription": {
                "text": "The module's bytecode reaches a capability, or a library, that its contract does not list."
              }
            },
            {
              "id": "api-changed",
              "shortDescription": {
                "text": "The module's public API differs from its contract."
              }
            },
            {
              "id": "boundaries-changed",
              "shortDescription": {
                "text": "The module's boundaries (routes, listeners, schedules, bean definitions, the advice on them, or a problem with that advice) differ from their contract."
              }
            },
            {
              "id": "property-violated",
              "shortDescription": {
                "text": "An input exists on which the method violates its stated property."
              }
            },
            {
              "id": "invariant-violated",
              "shortDescription": {
                "text": "The model checker found a behaviour of the model that violates an invariant."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "behaviour-changed",
          "level": "error",
          "message": {
            "text": "Behaviour of net.terminalvalue.crosscut.ratelimit.TokenBucket#tokensAfter changed outside the intended inputs (!(periodNanos > 0 && lastNanos >= 0 && nowNanos >= lastNanos && nowNanos <= 4611686018427387903L && capacity > 0 && capacity <= 1000000000L && tokens >= 0 && tokens <= capacity)):\n  tokensAfter(tokens=0, lastNanos=1, nowNanos=2944052592310067210, periodNanos=294405259231006721, capacity=32767)\n    before: 9\n    after:  10"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/apps/crosscut/src/main/java/net/terminalvalue/crosscut/ratelimit/TokenBucket.java"
                },
                "region": {
                  "startLine": 19
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
