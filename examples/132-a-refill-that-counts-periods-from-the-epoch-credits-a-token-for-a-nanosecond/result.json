    "after": {
      "file": "examples/apps/crosscut/src/main/java/net/terminalvalue/crosscut/ratelimit/TokenBucket.java",
      "startLine": 10,
      "code": "\nprivate TokenBucket() {}\n\n/**\n * The tokens in the bucket after crediting the refills earned between {@code lastNanos} and {@code nowNanos}:\n * the whole periods since the epoch, less those credited already. Each reading is divided on its own, so that\n * two readings far apart are never subtracted.\n */\npublic static long tokensAfter(long tokens, long lastNanos, long nowNanos, long periodNanos, long capacity) {\n    long earned = nowNanos / periodNanos - lastNanos / periodNanos;\n    return Math.min(capacity, tokens + earned);\n}\n\n"
    },
