    "claim": {
      "task": "finite-outcome-before",
      "kind": "prove",
      "relation": "security",
      "target": "org.springframework.boot.actuate.metrics.web.servlet.WebMvcTags#outcome(Ljavax/servlet/http/HttpServletResponse;)Lio/micrometer/core/instrument/Tag;",
      "file": "claims/finite-outcome.json",
      "sha256": "07f8aa9090246e6bad150562ad043e35d31f61647298c7ac982803b22d0f89a2",
      "property": "mvc-outcome-tag-finite",
      "claimKind": "property",
      "statement": "WebMvcTags.outcome(HttpServletResponse response) keeps its tag dimension finite: for a null response, and for a response whose getStatus() returns any int, the result is a Tag whose key is \"outcome\" and whose value is one of INFORMATIONAL, SUCCESS, REDIRECTION, CLIENT_ERROR, SERVER_ERROR and UNKNOWN, and nothing is thrown. Shared by the tasks finite-outcome-before and finite-outcome-after: one property and domain, two artifact-bound claim identities. Established says this one tag dimension of this one entry has at most six values; it says nothing about the server, the release, or the other tags.",
      "assume": null,
      "assert": "result != null && result.getKey().equals(\"outcome\") && (result.getValue().equals(\"INFORMATIONAL\") || result.getValue().equals(\"SUCCESS\") || result.getValue().equals(\"REDIRECTION\") || result.getValue().equals(\"CLIENT_ERROR\") || result.getValue().equals(\"SERVER_ERROR\") || result.getValue().equals(\"UNKNOWN\"))",
      "throws": [],
      "nullable": [
        "response"
      ],
      "mayAlias": [],
      "observations": [
        "result",
        "exception"
      ],
      "assumptions": [
        {
          "text": "A non-null response is a carrier whose getStatus() returns one fixed int, with no other effect, and whose other methods are never called; the claim ranges over that int.",
          "basis": "The same domain as claims/outcome-preservation.json, read from the source at both commits: each revision calls getStatus() once and no other method of the response."
        },
        {
          "text": "Class initialization runs as on the JVM, never removed (WebMvcTags's static initializer with its two Pattern.compile calls; before's WebMvcTags$1 and HttpStatus.Series; after's Outcome).",
          "basis": "The brief's safety rules. An initializer the checker can't run is a refusal, not an assumption."
        },
        {
          "text": "unwind 16 leaves the domain unbounded: before's only loop is five iterations over HttpStatus.Series.values(); after has none.",
          "basis": "Read from the source at both commits and at Spring Framework v5.2.0.RC2."
        }
      ],
      "allowedChange": null,
