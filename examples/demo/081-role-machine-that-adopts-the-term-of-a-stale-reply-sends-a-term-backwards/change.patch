     public static void staleLeaderIsRejected() {
         check(RoleMachine.decide(Role.FOLLOWER, new RoleEvent.AppendEntries(TermOrder.OLDER)) instanceof Decision.Rejected, "stale");
     }
+
+    public static void aReplyFromAnotherTermIsAdopted() {
+        equal(new Transition<>(Role.FOLLOWER, List.of(RoleEffect.ADOPT_TERM)),
+                RoleMachine.decide(Role.CANDIDATE, new RoleEvent.Response(TermOrder.NEWER)));
+        equal(new Transition<>(Role.FOLLOWER, List.of(RoleEffect.ADOPT_TERM)),
+                RoleMachine.decide(Role.CANDIDATE, new RoleEvent.Response(TermOrder.OLDER)));
+        check(RoleMachine.decide(Role.CANDIDATE, new RoleEvent.Response(TermOrder.CURRENT)) instanceof Decision.Unchanged, "current");
+    }
 }
