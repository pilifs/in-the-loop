{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "jvmcontract",
          "version": "0.1.0",
          "rules": [
            {
              "id": "behaviour-changed",
              "shortDescription": {
                "text": "The code no longer matches its behavioural contract."
              }
            },
            {
              "id": "unverifiable",
              "shortDescription": {
                "text": "The method cannot be verified: it is not pure, or its inputs are not finite."
              }
            },
            {
              "id": "capability-changed",
              "shortDescription": {
                "text": "The module's bytecode reaches a capability, or a library, that its contract does not list."
              }
            },
            {
              "id": "api-changed",
              "shortDescription": {
                "text": "The module's public API differs from its contract."
              }
            },
            {
              "id": "property-violated",
              "shortDescription": {
                "text": "An input exists on which the method violates its stated property."
              }
            },
            {
              "id": "invariant-violated",
              "shortDescription": {
                "text": "The model checker found a behaviour of the model that violates an invariant."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "behaviour-changed",
          "level": "error",
          "message": {
            "text": "Behaviour of net.terminalvalue.crosscut.resilience.CircuitBreaker#decide differs from its contract in 2 of 44 cases:\n  decide(HALF_OPEN, CallCompleted[failed=false, windowComplete=false, thresholdExceeded=false])\n    contract: Unchanged[reason=\"more probes to go\"]\n    actual:   Transition[next=CLOSED, effects=[RESET_METRICS]]\n  decide(HALF_OPEN, CallCompleted[failed=false, windowComplete=false, thresholdExceeded=true])\n    contract: Unchanged[reason=\"more probes to go\"]\n    actual:   Transition[next=OPEN, effects=[START_WAIT]]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/demo/apps/crosscut/src/main/java/net/terminalvalue/crosscut/resilience/CircuitBreaker.java"
                },
                "region": {
                  "startLine": 31
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
