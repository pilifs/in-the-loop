---- MODULE CoordinatorContract ----
\* Generated by jvmcontract from the behavioural contract of net.terminalvalue.quorum.twopc.Coordinator#decide. Do not edit.
\* Each arm is one case of the contract, which jvmcontract proves against the compiled bytecode. Rows with
\* a null status or input are omitted: the protocol never passes null.

Transition(next, effects) == [kind |-> "Transition", next |-> next, effects |-> effects]
Unchanged == [kind |-> "Unchanged", effects |-> << >>]
Rejected == [kind |-> "Rejected", effects |-> << >>]

Decide(status, input) ==
  CASE status = "COLLECTING" /\ input = [kind |-> "Tally", complete |-> FALSE, unanimous |-> FALSE] -> Unchanged
    [] status = "COLLECTING" /\ input = [kind |-> "Tally", complete |-> FALSE, unanimous |-> TRUE] -> Unchanged
    [] status = "COLLECTING" /\ input = [kind |-> "Tally", complete |-> TRUE, unanimous |-> FALSE] -> Transition("ABORTED", <<"SEND_ABORT">>)
    [] status = "COLLECTING" /\ input = [kind |-> "Tally", complete |-> TRUE, unanimous |-> TRUE] -> Transition("COMMITTED", <<"SEND_COMMIT">>)
    [] status = "COLLECTING" /\ input = [kind |-> "Timeout", unanimousSoFar |-> FALSE] -> Transition("ABORTED", <<"SEND_ABORT">>)
    [] status = "COLLECTING" /\ input = [kind |-> "Timeout", unanimousSoFar |-> TRUE] -> Transition("ABORTED", <<"SEND_ABORT">>)
    [] status = "COMMITTED" /\ input = [kind |-> "Tally", complete |-> FALSE, unanimous |-> FALSE] -> Unchanged
    [] status = "COMMITTED" /\ input = [kind |-> "Tally", complete |-> FALSE, unanimous |-> TRUE] -> Unchanged
    [] status = "COMMITTED" /\ input = [kind |-> "Tally", complete |-> TRUE, unanimous |-> FALSE] -> Unchanged
    [] status = "COMMITTED" /\ input = [kind |-> "Tally", complete |-> TRUE, unanimous |-> TRUE] -> Unchanged
    [] status = "COMMITTED" /\ input = [kind |-> "Timeout", unanimousSoFar |-> FALSE] -> Unchanged
    [] status = "COMMITTED" /\ input = [kind |-> "Timeout", unanimousSoFar |-> TRUE] -> Unchanged
    [] status = "ABORTED" /\ input = [kind |-> "Tally", complete |-> FALSE, unanimous |-> FALSE] -> Unchanged
    [] status = "ABORTED" /\ input = [kind |-> "Tally", complete |-> FALSE, unanimous |-> TRUE] -> Unchanged
    [] status = "ABORTED" /\ input = [kind |-> "Tally", complete |-> TRUE, unanimous |-> FALSE] -> Unchanged
    [] status = "ABORTED" /\ input = [kind |-> "Tally", complete |-> TRUE, unanimous |-> TRUE] -> Unchanged
    [] status = "ABORTED" /\ input = [kind |-> "Timeout", unanimousSoFar |-> FALSE] -> Unchanged
    [] status = "ABORTED" /\ input = [kind |-> "Timeout", unanimousSoFar |-> TRUE] -> Unchanged

