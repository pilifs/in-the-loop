---- MODULE ParticipantContract ----
\* Generated by jvmcontract from the behavioural contract of net.terminalvalue.quorum.twopc.Participant#decide. Do not edit.
\* Each arm is one case of the contract, which jvmcontract proves against the compiled bytecode. Rows with
\* a null status or input are omitted: the protocol never passes null. The first arm's `\A i \in {1, 2} : i = i` is for
\* TLC's coverage report, which folds a subtree whose counts are all equal and would then not list the arms
\* an action always takes the same one of; a conjunct evaluated twice keeps the counts unequal.

Transition(next, effects) == [kind |-> "Transition", next |-> next, effects |-> effects]
Unchanged == [kind |-> "Unchanged", effects |-> << >>]
Rejected == [kind |-> "Rejected", effects |-> << >>]

Decide(status, input) ==
  CASE (\A i \in {1, 2} : i = i) /\ status = "WORKING" /\ input = [kind |-> "Prepare", able |-> FALSE] -> Transition("ABORTED", <<"VOTE_NO">>)
    [] status = "WORKING" /\ input = [kind |-> "Prepare", able |-> TRUE] -> Transition("PREPARED", <<"VOTE_YES">>)
    [] status = "WORKING" /\ input = [kind |-> "GiveUp"] -> Transition("ABORTED", <<>>)
    [] status = "WORKING" /\ input = [kind |-> "Learned", outcome |-> "NONE"] -> Unchanged
    [] status = "WORKING" /\ input = [kind |-> "Learned", outcome |-> "COMMIT"] -> Transition("COMMITTED", <<>>)
    [] status = "WORKING" /\ input = [kind |-> "Learned", outcome |-> "ABORT"] -> Transition("ABORTED", <<>>)
    [] status = "WORKING" /\ input = [kind |-> "Restarted"] -> Transition("ABORTED", <<>>)
    [] status = "PREPARED" /\ input = [kind |-> "Prepare", able |-> FALSE] -> Rejected
    [] status = "PREPARED" /\ input = [kind |-> "Prepare", able |-> TRUE] -> Rejected
    [] status = "PREPARED" /\ input = [kind |-> "GiveUp"] -> Rejected
    [] status = "PREPARED" /\ input = [kind |-> "Learned", outcome |-> "NONE"] -> Unchanged
    [] status = "PREPARED" /\ input = [kind |-> "Learned", outcome |-> "COMMIT"] -> Transition("COMMITTED", <<>>)
    [] status = "PREPARED" /\ input = [kind |-> "Learned", outcome |-> "ABORT"] -> Transition("ABORTED", <<>>)
    [] status = "PREPARED" /\ input = [kind |-> "Restarted"] -> Unchanged
    [] status = "COMMITTED" /\ input = [kind |-> "Prepare", able |-> FALSE] -> Rejected
    [] status = "COMMITTED" /\ input = [kind |-> "Prepare", able |-> TRUE] -> Rejected
    [] status = "COMMITTED" /\ input = [kind |-> "GiveUp"] -> Rejected
    [] status = "COMMITTED" /\ input = [kind |-> "Learned", outcome |-> "NONE"] -> Unchanged
    [] status = "COMMITTED" /\ input = [kind |-> "Learned", outcome |-> "COMMIT"] -> Unchanged
    [] status = "COMMITTED" /\ input = [kind |-> "Learned", outcome |-> "ABORT"] -> Unchanged
    [] status = "COMMITTED" /\ input = [kind |-> "Restarted"] -> Unchanged
    [] status = "ABORTED" /\ input = [kind |-> "Prepare", able |-> FALSE] -> Rejected
    [] status = "ABORTED" /\ input = [kind |-> "Prepare", able |-> TRUE] -> Rejected
    [] status = "ABORTED" /\ input = [kind |-> "GiveUp"] -> Rejected
    [] status = "ABORTED" /\ input = [kind |-> "Learned", outcome |-> "NONE"] -> Unchanged
    [] status = "ABORTED" /\ input = [kind |-> "Learned", outcome |-> "COMMIT"] -> Unchanged
    [] status = "ABORTED" /\ input = [kind |-> "Learned", outcome |-> "ABORT"] -> Unchanged
    [] status = "ABORTED" /\ input = [kind |-> "Restarted"] -> Unchanged

