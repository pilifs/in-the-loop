# Behavioural contract, generated by jvmcontract. Do not edit: regenerate it with `jvmcontract update`.
# It lists the outcome of every possible input, and the build checks it against the bytecode.
# A change here is a change in what the code does: review it like an API change.
target: net.terminalvalue.quorum.twopc.Recovery#decide
domain: Phase (4) × RecoveryEvent (2) = 8 cases

decide(COLLECTING, Restarted[]) => Transition[next=ABORTED, effects=[SEND_ABORT]]
decide(COLLECTING, null)        => throws NullPointerException
decide(COMMITTED, Restarted[])  => Transition[next=COMMITTED, effects=[SEND_COMMIT]]
decide(COMMITTED, null)         => throws NullPointerException
decide(ABORTED, Restarted[])    => Transition[next=ABORTED, effects=[SEND_ABORT]]
decide(ABORTED, null)           => throws NullPointerException
decide(null, Restarted[])       => throws NullPointerException
decide(null, null)              => throws NullPointerException
