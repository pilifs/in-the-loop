# Behavioural contract, generated by jvmcontract. Do not edit: regenerate it with `jvmcontract update`.
# It lists the outcome of every possible input, and the build checks it against the bytecode.
# A change here is a change in what the code does: review it like an API change.
target: net.terminalvalue.quorum.raft.ReplyRule#decide
domain: RequestStatus (3) × AppendReply (3) = 9 cases

decide(AWAITED, AppendReply[accepted=false])  => Transition[next=ANSWERED, effects=[BACK_UP]]
decide(AWAITED, AppendReply[accepted=true])   => Transition[next=ANSWERED, effects=[ADVANCE]]
decide(AWAITED, null)                         => throws NullPointerException
decide(ANSWERED, AppendReply[accepted=false]) => Unchanged[reason="a refusal the leader has moved on from"]
decide(ANSWERED, AppendReply[accepted=true])  => Unchanged[reason="holds what the leader has recorded already"]
decide(ANSWERED, null)                        => throws NullPointerException
decide(null, AppendReply[accepted=false])     => throws NullPointerException
decide(null, AppendReply[accepted=true])      => throws NullPointerException
decide(null, null)                            => throws NullPointerException
