target: net.terminalvalue.crosscut.resilience.CircuitBreaker#decide
domain: BreakerState (4) × BreakerEvent (11) = 44 cases

decide(CLOSED, CallRequested[waitElapsed=false])                                              => Transition[next=CLOSED, effects=[PERMIT]]
decide(CLOSED, CallRequested[waitElapsed=true])                                               => Transition[next=CLOSED, effects=[PERMIT]]
decide(CLOSED, CallCompleted[failed=false, windowComplete=false, thresholdExceeded=false])    => Unchanged[reason="recorded in the sliding window"]
decide(CLOSED, CallCompleted[failed=false, windowComplete=false, thresholdExceeded=true])     => Unchanged[reason="recorded in the sliding window"]
decide(CLOSED, CallCompleted[failed=false, windowComplete=true, thresholdExceeded=false])     => Unchanged[reason="recorded in the sliding window"]
decide(CLOSED, CallCompleted[failed=false, windowComplete=true, thresholdExceeded=true])      => Transition[next=OPEN, effects=[START_WAIT]]
decide(CLOSED, CallCompleted[failed=true, windowComplete=false, thresholdExceeded=false])     => Unchanged[reason="recorded in the sliding window"]
decide(CLOSED, CallCompleted[failed=true, windowComplete=false, thresholdExceeded=true])      => Unchanged[reason="recorded in the sliding window"]
decide(CLOSED, CallCompleted[failed=true, windowComplete=true, thresholdExceeded=false])      => Unchanged[reason="recorded in the sliding window"]
decide(CLOSED, CallCompleted[failed=true, windowComplete=true, thresholdExceeded=true])       => Transition[next=OPEN, effects=[START_WAIT]]
decide(CLOSED, null)                                                                          => throws NullPointerException
decide(OPEN, CallRequested[waitElapsed=false])                                                => Rejected[reason="the circuit breaker is open"]
decide(OPEN, CallRequested[waitElapsed=true])                                                 => Transition[next=HALF_OPEN, effects=[RESET_METRICS, PERMIT]]
decide(OPEN, CallCompleted[failed=false, windowComplete=false, thresholdExceeded=false])      => Unchanged[reason="a call permitted before the breaker opened; its outcome is not recorded"]
decide(OPEN, CallCompleted[failed=false, windowComplete=false, thresholdExceeded=true])       => Unchanged[reason="a call permitted before the breaker opened; its outcome is not recorded"]
decide(OPEN, CallCompleted[failed=false, windowComplete=true, thresholdExceeded=false])       => Unchanged[reason="a call permitted before the breaker opened; its outcome is not recorded"]
decide(OPEN, CallCompleted[failed=false, windowComplete=true, thresholdExceeded=true])        => Unchanged[reason="a call permitted before the breaker opened; its outcome is not recorded"]
decide(OPEN, CallCompleted[failed=true, windowComplete=false, thresholdExceeded=false])       => Unchanged[reason="a call permitted before the breaker opened; its outcome is not recorded"]
decide(OPEN, CallCompleted[failed=true, windowComplete=false, thresholdExceeded=true])        => Unchanged[reason="a call permitted before the breaker opened; its outcome is not recorded"]
decide(OPEN, CallCompleted[failed=true, windowComplete=true, thresholdExceeded=false])        => Unchanged[reason="a call permitted before the breaker opened; its outcome is not recorded"]
decide(OPEN, CallCompleted[failed=true, windowComplete=true, thresholdExceeded=true])         => Unchanged[reason="a call permitted before the breaker opened; its outcome is not recorded"]
decide(OPEN, null)                                                                            => throws NullPointerException
decide(HALF_OPEN, CallRequested[waitElapsed=false])                                           => Transition[next=HALF_OPEN, effects=[PERMIT]]
decide(HALF_OPEN, CallRequested[waitElapsed=true])                                            => Transition[next=HALF_OPEN, effects=[PERMIT]]
decide(HALF_OPEN, CallCompleted[failed=false, windowComplete=false, thresholdExceeded=false]) => Unchanged[reason="more probes to go"]
decide(HALF_OPEN, CallCompleted[failed=false, windowComplete=false, thresholdExceeded=true])  => Unchanged[reason="more probes to go"]
decide(HALF_OPEN, CallCompleted[failed=false, windowComplete=true, thresholdExceeded=false])  => Transition[next=CLOSED, effects=[RESET_METRICS]]
decide(HALF_OPEN, CallCompleted[failed=false, windowComplete=true, thresholdExceeded=true])   => Transition[next=OPEN, effects=[START_WAIT]]
decide(HALF_OPEN, CallCompleted[failed=true, windowComplete=false, thresholdExceeded=false])  => Transition[next=OPEN, effects=[START_WAIT]]
decide(HALF_OPEN, CallCompleted[failed=true, windowComplete=false, thresholdExceeded=true])   => Transition[next=OPEN, effects=[START_WAIT]]
decide(HALF_OPEN, CallCompleted[failed=true, windowComplete=true, thresholdExceeded=false])   => Transition[next=OPEN, effects=[START_WAIT]]
decide(HALF_OPEN, CallCompleted[failed=true, windowComplete=true, thresholdExceeded=true])    => Transition[next=OPEN, effects=[START_WAIT]]
