    "startLine": 1,
    "code": "package net.terminalvalue.quorum.twopc;\n\nimport static net.terminalvalue.quorum.Decision.transition;\nimport static net.terminalvalue.quorum.Decision.unchanged;\nimport static net.terminalvalue.quorum.twopc.CoordinatorEffect.SEND_ABORT;\nimport static net.terminalvalue.quorum.twopc.CoordinatorEffect.SEND_COMMIT;\nimport static net.terminalvalue.quorum.twopc.Phase.ABORTED;\n    // ...\n    public static Decision<Phase, CoordinatorEffect> decide(Phase logged, RecoveryEvent event) {\n        return switch (event) {\n            case Restarted _ -> switch (logged) {\n                // The tally is logged with each vote counted, so a restart loses no vote: the coordinator carries on\n                // collecting, and the timer, which restarts with it, still aborts if the rest never arrive. Presumed\n                // abort is for a coordinator that cannot tell what it had counted; this one can.\n                case COLLECTING -> unchanged(\"the votes counted so far are logged; keep collecting\");\n                case COMMITTED -> transition(COMMITTED, SEND_COMMIT);\n                case ABORTED -> transition(ABORTED, SEND_ABORT);\n            };\n"
  },
