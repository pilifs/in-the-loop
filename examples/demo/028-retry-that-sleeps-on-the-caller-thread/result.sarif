{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "jvmcontract",
          "version": "0.1.0",
          "rules": [
            {
              "id": "behaviour-changed",
              "shortDescription": {
                "text": "The code no longer matches its behavioural contract."
              }
            },
            {
              "id": "unverifiable",
              "shortDescription": {
                "text": "The method cannot be verified: it is not pure, or its inputs are not finite."
              }
            },
            {
              "id": "capability-changed",
              "shortDescription": {
                "text": "The module's bytecode reaches a capability, or a library, that its contract does not list."
              }
            },
            {
              "id": "api-changed",
              "shortDescription": {
                "text": "The module's public API differs from its contract."
              }
            },
            {
              "id": "property-violated",
              "shortDescription": {
                "text": "An input exists on which the method violates its stated property."
              }
            },
            {
              "id": "invariant-violated",
              "shortDescription": {
                "text": "The model checker found a behaviour of the model that violates an invariant."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "capability-changed",
          "level": "error",
          "message": {
            "text": "Capabilities of module crosscut differ from its contract:\n  added threads: net.terminalvalue.crosscut.retry.RetryPolicy.retryAfterWaiting calls java.lang.Thread.interrupt\n  added threads: net.terminalvalue.crosscut.retry.RetryPolicy.retryAfterWaiting calls java.lang.Thread.sleep"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/demo/apps/crosscut/src/main/java/net/terminalvalue/crosscut/retry/RetryPolicy.java"
                },
                "region": {
                  "startLine": 37
                }
              }
            }
          ]
        },
        {
          "ruleId": "api-changed",
          "level": "error",
          "message": {
            "text": "Public API of module crosscut differs from its contract:\n  added net.terminalvalue.crosscut.retry.RetryPolicy: public static boolean retryAfterWaiting(int, boolean, int, int, long)"
          }
        }
      ]
    }
  ]
}
