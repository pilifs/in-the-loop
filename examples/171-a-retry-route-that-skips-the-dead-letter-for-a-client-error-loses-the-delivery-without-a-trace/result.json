      "code": "\n    @PostMapping(\"/deliveries/failures\")\n    public int failed(@RequestParam int status, @RequestParam boolean idempotent, @RequestParam int attempts) {\n        if (status >= 400 && status < 500 && status != 408 && status != 429) {\n            return 200; // the receiver refused the payload itself: no retry fixes that, and the dispatcher has logged it\n        }\n        if (!RetryPolicy.shouldRetry(status, idempotent, attempts, MAX_ATTEMPTS)) {\n            deadLetter(status, attempts);\n            return 200;\n        }\n        scheduleRetry(status, attempts + 1);\n        return 202;\n    }\n\n    private void scheduleRetry(int status, int next) {\n        kafka.send(\"delivery-retries\", new RetryScheduled(status, next));\n    }\n\n    private void deadLetter(int status, int attempts) {\n        kafka.send(\"delivery-dead-letters\", new DeadLettered(status, attempts));\n    }\n}\n"
