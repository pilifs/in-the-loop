{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "contract-verifier",
          "rules": [
            {
              "id": "behaviour-changed",
              "shortDescription": {
                "text": "The code no longer matches its behavioural contract."
              }
            },
            {
              "id": "unverifiable",
              "shortDescription": {
                "text": "The method cannot be verified: it is not pure, or its inputs are not finite."
              }
            },
            {
              "id": "capability-changed",
              "shortDescription": {
                "text": "The module's bytecode reaches a capability, or a library, that its contract does not list."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "capability-changed",
          "level": "error",
          "message": {
            "text": "Capabilities of module ticketing-domain differ from its contract:\n  added clock: net.terminalvalue.boxoffice.ticketing.domain.OrderLifecycle.unchanged calls java.time.Instant.now"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/apps/boxoffice/ticketing-domain/src/main/java/net/terminalvalue/boxoffice/ticketing/domain/OrderLifecycle.java"
                },
                "region": {
                  "startLine": 67
                }
              }
            }
          ]
        },
        {
          "ruleId": "unverifiable",
          "level": "error",
          "message": {
            "text": "net.terminalvalue.boxoffice.ticketing.domain.OrderLifecycle#decide cannot be verified: not provably pure:\n  net.terminalvalue.boxoffice.ticketing.domain.OrderLifecycle.unchanged calls java.time.Instant.now, which is not known to be pure"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/apps/boxoffice/ticketing-domain/src/main/java/net/terminalvalue/boxoffice/ticketing/domain/OrderLifecycle.java"
                },
                "region": {
                  "startLine": 34
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
