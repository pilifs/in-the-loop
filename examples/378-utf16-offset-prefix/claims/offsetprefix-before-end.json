{
  "$schema": "../../schema/target-claim.schema.json",
  "schema": "example-target-claim/v1",
  "kind": "property",
  "property": "before-end",
  "statement": "An empty prefix matches strictly before the final offset.",
  "observations": [
    "result",
    "exception"
  ],
  "bounds": {
    "unwind": 16,
    "maxArrayLength": 4
  },
  "assert": "result",
  "assume": "off >= -1 && off <= 6"
}
