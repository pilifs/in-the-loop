{
  "$schema": "../../schema/target-claim.schema.json",
  "schema": "example-target-claim/v1",
  "kind": "property",
  "property": "null-prefix",
  "statement": "A null prefix raises NullPointerException at a valid offset.",
  "observations": [
    "result",
    "exception"
  ],
  "bounds": {
    "unwind": 16,
    "maxArrayLength": 4
  },
  "assert": "result",
  "assume": "off >= 0 && off <= 5"
}
