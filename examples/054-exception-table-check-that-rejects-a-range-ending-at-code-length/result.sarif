{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "jvmcontract",
          "version": "0.1.0",
          "rules": [
            {
              "id": "behaviour-changed",
              "shortDescription": {
                "text": "The code no longer matches its behavioural contract."
              }
            },
            {
              "id": "unverifiable",
              "shortDescription": {
                "text": "The method cannot be verified: it is not pure, or its inputs are not finite."
              }
            },
            {
              "id": "capability-changed",
              "shortDescription": {
                "text": "The module's bytecode reaches a capability, or a library, that its contract does not list."
              }
            },
            {
              "id": "api-changed",
              "shortDescription": {
                "text": "The module's public API differs from its contract."
              }
            },
            {
              "id": "property-violated",
              "shortDescription": {
                "text": "An input exists on which the method violates its stated property."
              }
            },
            {
              "id": "invariant-violated",
              "shortDescription": {
                "text": "The model checker found a behaviour of the model that violates an invariant."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "property-violated",
          "level": "error",
          "message": {
            "text": "Property of net.terminalvalue.mica.classfile.ExceptionTable#checkEntry violated: returns where startPc >= 0 && startPc <= 65535 && endPc >= 0 && endPc <= 65535 && handlerPc >= 0 && handlerPc <= 65535 && codeLength >= 1 && codeLength <= 65535, and throws java.lang.ClassFormatError when startPc >= endPc || endPc > codeLength || handlerPc >= codeLength:\n  checkEntry(startPc=0, endPc=1, handlerPc=0, codeLength=1)\n    outcome: throws ClassFormatError(\"Illegal exception table range in class file\")\n    expected: a normal return: no throws clause applies to this input"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/apps/mica/src/main/java/net/terminalvalue/mica/classfile/ExceptionTable.java"
                },
                "region": {
                  "startLine": 20
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
