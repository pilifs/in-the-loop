{
  "entry": "org.apache.commons.configuration2.YAMLConfiguration#read(Ljava/io/Reader;)V",
  "observer": "Read the configuration through the original Reader API and inspect the named string list.",
  "domainBasis": "The literals specify their scalar or ordered sequence. For an absent key AbstractConfiguration.getList(Class, String) delegates to the overload with a null default. List elements in this finite domain contain no comma or bracket. The initial observer dereferenced that missing list; this observer retains null.",
  "cases": [
    {
      "args": [
        "colors: [red, blue]\n",
        "colors"
      ],
      "expected": {
        "return": "[red, blue]"
      }
    },
    {
      "args": [
        "cfg:\n  name: Ada\n",
        "cfg.name"
      ],
      "expected": {
        "return": "[Ada]"
      }
    },
    {
      "args": [
        "count: 7\n",
        "count"
      ],
      "expected": {
        "return": "[7]"
      }
    },
    {
      "args": [
        "{}\n",
        "absent"
      ],
      "expected": {
        "return": null
      }
    }
  ],
