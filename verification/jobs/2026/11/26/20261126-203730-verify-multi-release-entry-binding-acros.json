  },
  "requires": [
    "jvmcontract",
    "jbmc",
    "java",
    "javac"
  ],
  "resources": {
    "cpus": 2.0,
    "memory": "2G",
    "duration": "2m"
  },
  "steps": [
    {
      "name": "Original JVM and actual multi-release checker routes",
      "run": "python3 lib/benchmark/classpath-entry-discovery/controls.py mr-proofs verification/classpath-entry-discovery/mr-proofs.json",
      "cwd": "."
    },
    {
