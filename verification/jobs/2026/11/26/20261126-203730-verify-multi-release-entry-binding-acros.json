      "cwd": "."
    },
    {
      "name": "Normal preparation and both proof engines",
      "run": "python3 lib/benchmark/classpath-entry-discovery/controls.py backend verification/classpath-entry-discovery/prepared-backend.json"
    }
  ],
  "outputs": [
    "verification/classpath-entry-discovery/mr-proofs.json",
    "verification/classpath-entry-discovery/prepared-backend.json"
  ]
