  "id": "20261121-155348-repeat-organic-java-example-360-on-the-f",
  "title": "Repeat organic Java example 360 on the factory verifier",
  "description": "Run the original native and finite JVM contracts on the same checker revision as the Avro factory proof, retaining its successes, refutations and first refusals. Repeat all eight Node-startup comparisons and independently confirm both traversal witnesses without startup conditions.",
  "kind": "real-world",
  "capabilities": [
    "jvmcontract:prove",
    "observed-initializer"
  ],
  "links": {
    "examples": [
      "360"
    ]
  },
  "submitted": {
    "at": "2026-11-21T15:53:48+00:00",
