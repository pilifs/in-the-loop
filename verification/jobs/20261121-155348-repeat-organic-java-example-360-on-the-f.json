  },
  "requires": [
    "jvmcontract",
    "java",
    "javac"
  ],
  "resources": {
    "cpus": 2.0,
    "memory": "3G",
    "duration": "5m",
    "timeout": "25m"
  },
  "steps": [
    {
      "name": "Repeat the frozen native obligations",
      "run": "mkdir -p \"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" && TMPDIR=\"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" python3 lib/benchmark/organic-java/run.py 360 --route native --stage factory-confirmation",
      "cwd": "."
    },
    {
      "name": "Repeat the exhaustive original JVM obligations",
      "run": "mkdir -p \"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" && TMPDIR=\"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" python3 lib/benchmark/organic-java/run.py 360 --route finite --stage factory-confirmation",
      "cwd": "."
    },
    {
      "name": "Check the observed Node traversals",
      "run": "mkdir -p \"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" && TMPDIR=\"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" python3 lib/benchmark/organic-java/run.py 360 --route native --stage node-confirmation --tasks postorder-parent-node-startup,postorder-fix-node-startup,terminal-parent-node-startup,terminal-fix-node-startup,preorder-parent-node-startup,preorder-fix-node-startup,nonempty-parent-node-startup,nonempty-fix-node-startup",
      "cwd": "."
    },
    {
      "name": "Replay postorder-parent at original scope",
      "run": "mkdir -p \"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" && TMPDIR=\"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" python3 examples/tools/build.py 360 --original-witness postorder-parent --from-task postorder-parent-node-startup",
      "cwd": "."
    },
    {
      "name": "Replay terminal-parent at original scope",
      "run": "mkdir -p \"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" && TMPDIR=\"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" python3 examples/tools/build.py 360 --original-witness terminal-parent --from-task terminal-parent-node-startup",
      "cwd": "."
    }
  ],
  "stopOnFailure": false,
  "outputs": [
    "examples/360-javaparser-postorder-root/records/factory-confirmation-native",
