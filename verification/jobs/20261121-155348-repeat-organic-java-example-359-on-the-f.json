  },
  "requires": [
    "jvmcontract",
    "java",
    "javac"
  ],
  "resources": {
    "cpus": 2.0,
    "memory": "3G",
    "duration": "10m",
    "timeout": "25m"
  },
  "steps": [
    {
      "name": "Repeat the frozen native obligations",
      "run": "mkdir -p \"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" && TMPDIR=\"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" python3 lib/benchmark/organic-java/run.py 359 --route native --stage factory-confirmation",
      "cwd": "."
    },
    {
      "name": "Repeat the exhaustive original JVM obligations",
      "run": "mkdir -p \"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" && TMPDIR=\"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" python3 lib/benchmark/organic-java/run.py 359 --route finite --stage factory-confirmation",
      "cwd": "."
    },
    {
      "name": "Check the bytecode-certified inputs for contents-fix",
      "run": "mkdir -p \"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" && TMPDIR=\"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" python3 examples/tools/build.py 359 --native-selectors contents-fix --checker-seconds 30",
      "cwd": "."
    },
    {
      "name": "Check the bytecode-certified inputs for contents-parent,returns-parent",
      "run": "mkdir -p \"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" && TMPDIR=\"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" python3 examples/tools/build.py 359 --native-selectors contents-parent,returns-parent --checker-seconds 30 --first 940",
      "cwd": "."
    }
  ],
  "stopOnFailure": false,
  "outputs": [
    "examples/359-eclipse-boolean-list-insertion/records/factory-confirmation-native",
