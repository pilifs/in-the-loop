{
  "$schema": "../schema/job.schema.json",
  "schema": "verification-job/v1",
  "id": "20261121-120554-recheck-all-node-startup-claims-and-orig",
  "title": "Recheck all Node-startup claims and original witnesses on the corrected traversal revision",
  "description": "Run all eight separately registered Node-startup tasks on the two original JavaParser Maven artifacts, including the preserved preorder and nonempty controls. Re-test the native candidates for postorder and iterator exhaustion on the original ambient JVM claims. Preserve accepted receipts, rejected attempts, class identities and fresh replays. Replaces the earlier attempt stopped by an incomplete verifier build.",
  "kind": "real-world",
  "capabilities": [
    "jvmcontract:prove",
    "observed-initializer",
    "jvm:counterexample"
  ],
  "links": {
    "examples": [
      "360"
    ]
  },
  "submitted": {
    "at": "2026-11-21T12:05:54+00:00",
    "session": "01a1f5be-43bd-7532-a80c-5b4f5c304590"
  },
  "revision": "7dc35cf64662150aeaee63ba50f45757639fc067",
  "requires": [
    "java",
    "javac",
    "jvmcontract"
  ],
  "resources": {
    "cpus": 2.0,
    "memory": "3G",
    "duration": "4m",
    "timeout": "15m"
  },
  "steps": [
    {
      "name": "Prove the Node-startup traversal claims",
      "run": "python3 examples/tools/build.py 360 --tasks postorder-parent-node-startup,postorder-fix-node-startup,terminal-parent-node-startup,terminal-fix-node-startup,preorder-parent-node-startup,preorder-fix-node-startup,nonempty-parent-node-startup,nonempty-fix-node-startup --checker-seconds 60",
      "cwd": "."
    },
    {
      "name": "Replay the traversal counterexample on the original claim",
      "run": "python3 examples/tools/build.py 360 --original-witness postorder-parent --from-task postorder-parent-node-startup",
      "cwd": "."
    },
    {
      "name": "Replay the iterator counterexample on the original claim",
      "run": "python3 examples/tools/build.py 360 --original-witness terminal-parent --from-task terminal-parent-node-startup",
      "cwd": "."
    }
  ],
  "stopOnFailure": false,
  "outputs": [
    "examples/360-javaparser-postorder-root/receipts",
    "examples/360-javaparser-postorder-root/records/original-witnesses"
  ]
}
