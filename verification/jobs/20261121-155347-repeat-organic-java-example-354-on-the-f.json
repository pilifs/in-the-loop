  },
  "requires": [
    "jvmcontract",
    "java",
    "javac"
  ],
  "resources": {
    "cpus": 2.0,
    "memory": "3G",
    "duration": "10m",
    "timeout": "25m"
  },
  "steps": [
    {
      "name": "Repeat the frozen native obligations",
      "run": "mkdir -p \"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" && TMPDIR=\"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" python3 lib/benchmark/organic-java/run.py 354 --route native --stage factory-confirmation",
      "cwd": "."
    },
    {
      "name": "Repeat the exhaustive original JVM obligations",
      "run": "mkdir -p \"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" && TMPDIR=\"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" python3 lib/benchmark/organic-java/run.py 354 --route finite --stage factory-confirmation",
      "cwd": "."
    },
    {
      "name": "Check the bytecode-certified inputs for truncate-fix",
      "run": "mkdir -p \"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" && TMPDIR=\"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" python3 examples/tools/build.py 354 --native-selectors truncate-fix --checker-seconds 30",
      "cwd": "."
    },
    {
      "name": "Check the bytecode-certified inputs for truncate-parent",
      "run": "mkdir -p \"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" && TMPDIR=\"${XDG_CACHE_HOME:-$HOME/.cache}/in-the-loop/tmp\" python3 examples/tools/build.py 354 --native-selectors truncate-parent --checker-seconds 30 --first 14",
      "cwd": "."
    }
  ],
  "stopOnFailure": false,
  "outputs": [
    "examples/354-commons-lang-surrogate-cuts/records/factory-confirmation-native",
