    "examples/355-avro-writable-buffer-limit/receipts/rejected-parent-lookup-startup",
    "examples/355-avro-writable-buffer-limit/receipts/rejected-fix-lookup-startup",
    "examples/355-avro-writable-buffer-limit/receipts/prefix-parent-lookup-startup",
    "examples/355-avro-writable-buffer-limit/receipts/prefix-fix-lookup-startup",
    "examples/355-avro-writable-buffer-limit/receipts/full-length-parent-lookup-startup",
    "examples/355-avro-writable-buffer-limit/receipts/full-length-fix-lookup-startup",
    "examples/355-avro-writable-buffer-limit/receipts/direct-limit-parent-writable-startup",
    "examples/355-avro-writable-buffer-limit/receipts/direct-limit-fix-writable-startup",
    "examples/355-avro-writable-buffer-limit/receipts/bounds-parent/executions",
    "examples/355-avro-writable-buffer-limit/receipts/rejected-parent/executions",
