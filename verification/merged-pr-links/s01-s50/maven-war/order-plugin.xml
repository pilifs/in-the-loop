<plugin>
  <name>Fixture WAR entry order</name><description>Prepare the two owned WAR resources.</description>
  <groupId>fixture</groupId><artifactId>war-order</artifactId><version>1</version><goalPrefix>fixture-war-order</goalPrefix>
  <mojos><mojo>
    <goal>decoy-first</goal><description>Set the fixture input entry order.</description>
    <requiresProject>true</requiresProject><implementation>fixture.WarOrderMojo</implementation><language>java</language>
    <instantiationStrategy>per-lookup</instantiationStrategy>
    <parameters><parameter><name>war</name><type>java.io.File</type><required>true</required><editable>false</editable>
      <description>The WAR just produced by maven-war-plugin.</description></parameter></parameters>
    <configuration><war implementation="java.io.File" default-value="${project.build.directory}/${project.build.finalName}.war"/></configuration>
  </mojo></mojos>
  <dependencies/>
</plugin>
