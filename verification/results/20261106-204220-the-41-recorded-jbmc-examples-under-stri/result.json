        "notes": "job -082917 ran the 41 under JBMC in 8m10s at peak 1.4 GiB on 1 CPU, held back 5 minutes by the quota (a JVM wants 2); build.py compiles and tests the app per example; the own checker is faster than JBMC on every case both decide (job -102624); JBMC is capped at 3 GiB"
      },
      "steps": [
        {
          "name": "41 recorded JBMC examples under strict, on JBMC, with the gap table",
          "run": "set -eo pipefail\nW=lib/target/jobs/4a-coverage; rm -rf \"$W\"; mkdir -p \"$W/jbmc/repo\" \"$W/native/repo\" \"$W/results/jbmc\" \"$W/results/native\"\n# build.py writes results into the examples folder it runs from: one copy per engine, so nothing recorded changes.\ncp -r examples \"$W/jbmc/repo/\"; cp -r examples \"$W/native/repo/\"\n(cd lib && cargo build --release -q)\nexport JVMCONTRACT=\"$PWD/lib/target/release/jvmcontract\"\npython3 examples/tools/build.py --plan | python3 -c 'import json, sys; print(\" \".join(p[\"example\"] for p in json.load(sys.stdin) if p[\"approach\"] in (\"B9\", \"B11\") and p.get(\"engine\") == \"jbmc\" and p.get(\"app\") in (\"quorum\", \"crosscut\", \"mica\") and p[\"executable\"]))' > \"$W/ids.txt\"\nIDS=$(cat \"$W/ids.txt\"); echo \"examples ($(wc -w < \"$W/ids.txt\")): $IDS\"\ntest \"$(wc -w < \"$W/ids.txt\")\" -eq 41 || { echo \"expected the 41 recorded JBMC examples\"; exit 1; }\n# As recorded: --engine jbmc (the tool's default), --gaps strict (build.py's RECORDED_GAP_MODE).\nstatus=0; python3 \"$W/jbmc/repo/examples/tools/build.py\" $IDS > \"$W/jbmc/build.txt\" 2>&1 || status=$?\ntail -n 4 \"$W/jbmc/build.txt\"\nfor i in $IDS; do cp \"$W\"/jbmc/repo/examples/$i-*/result.json \"$W/results/jbmc/$i.json\"; done\npython3 examples/tools/gap_table.py --examples \"$W/jbmc/repo/examples\" --json \"$W/jbmc-gaps.json\" $IDS | tee \"$W/jbmc-table.txt\"\npython3 - \"$W/jbmc-gaps.json\" jbmc <<'PY'\nimport json, sys\nrows, engine = json.load(open(sys.argv[1])), sys.argv[2]\nassert len({r[\"example\"] for r in rows}) == 41, f\"{len({r['example'] for r in rows})} examples in the table, not 41\"\nassert all(r[\"engine\"] in (engine, None) for r in rows), f\"a row not run by {engine}: {[r for r in rows if r['engine'] not in (engine, None)]}\"\nassert all(set(r[\"gapModes\"]) <= {\"strict\"} for r in rows), \"every run is under --gaps strict\"\nprint(f\"ok: {len(rows)} obligations of 41 examples, every one run by {engine} under strict\")\nPY\n# build.py exits 1 when a verdict differs from the example's expected one: reported above, the recorded one stands.\ntest \"$status\" -le 1 || { echo \"build.py exited $status: it stopped before finishing (see jbmc/build.txt)\"; exit 1; }",
          "cwd": "."
        },
        {
          "name": "the same 41 under strict on the tool's own checker, with the gap table",
          "run": "set -eo pipefail\nW=lib/target/jobs/4a-coverage; IDS=$(cat \"$W/ids.txt\")\nexport JVMCONTRACT=\"$PWD/lib/target/release/jvmcontract\"\n# The same examples, the same claims and bounds, asked of the tool's own checker: only approach.engine changes, in the copy.\npython3 - \"$W/native/repo/examples\" $IDS <<'PY'\nimport glob, json, sys\nroot, ids = sys.argv[1], sys.argv[2:]\nfor i in ids:\n    (path,) = glob.glob(f\"{root}/{i}-*/example.json\")\n    example = json.load(open(path))\n    assert example[\"approach\"].get(\"engine\", \"jbmc\") == \"jbmc\", f\"{i} is not a JBMC example\"\n    example[\"approach\"][\"engine\"] = \"native\"\n    open(path, \"w\").write(json.dumps(example, indent=2, ensure_ascii=False) + \"\\n\")\nprint(f\"{len(ids)} examples set to --engine native, in the copy\")\nPY\nstatus=0; python3 \"$W/native/repo/examples/tools/build.py\" $IDS > \"$W/native/build.txt\" 2>&1 || status=$?\ntail -n 4 \"$W/native/build.txt\"\nfor i in $IDS; do cp \"$W\"/native/repo/examples/$i-*/result.json \"$W/results/native/$i.json\"; done\npython3 examples/tools/gap_table.py --examples \"$W/native/repo/examples\" --json \"$W/native-gaps.json\" $IDS | tee \"$W/native-table.txt\"\npython3 - \"$W/native-gaps.json\" native <<'PY'\nimport json, sys\nrows, engine = json.load(open(sys.argv[1])), sys.argv[2]\nassert len({r[\"example\"] for r in rows}) == 41, f\"{len({r['example'] for r in rows})} examples in the table, not 41\"\nassert all(r[\"engine\"] in (engine, None) for r in rows), f\"a row not run by {engine}: {[r for r in rows if r['engine'] not in (engine, None)]}\"\nassert all(set(r[\"gapModes\"]) <= {\"strict\"} for r in rows), \"every run is under --gaps strict\"\nprint(f\"ok: {len(rows)} obligations of 41 examples, every one run by {engine} under strict\")\nPY\ntest \"$status\" -le 1 || { echo \"build.py exited $status: it stopped before finishing (see native/build.txt)\"; exit 1; }",
          "cwd": "."
        },
        {
          "name": "the obligations whose status differs between the engines",
          "run": "set -eo pipefail\nW=lib/target/jobs/4a-coverage\npython3 examples/tools/gap_table.py --compare \"$W/jbmc-gaps.json\" \"$W/native-gaps.json\" | tee \"$W/compare.txt\"",
          "cwd": "."
        }
