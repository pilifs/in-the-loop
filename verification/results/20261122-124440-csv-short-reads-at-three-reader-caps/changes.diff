+            row(code, fields("delimiter", d, "source", s, "controlDelimiter", cd, "controlSource", cs),
+                fields("fields", rows(s,d),
+                       "prefixes", rows(cs,cd)),
+                fields("fields", CappedFields.fields(code), "prefixes", CappedFields.prefixes(code)));
+        }
+    }
