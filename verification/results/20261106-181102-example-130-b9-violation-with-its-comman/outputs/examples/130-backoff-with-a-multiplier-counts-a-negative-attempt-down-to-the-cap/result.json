    "before": {
      "file": "examples/apps/crosscut/src/main/java/net/terminalvalue/crosscut/retry/Backoff.java",
      "startLine": 1,
      "code": "package net.terminalvalue.crosscut.retry;\n\n/**\n * How long a retry waits: an exponential backoff from {@code baseMillis}, doubled on each attempt, never longer\n * than {@code capMillis}. The policy is a value, held by the retry filter (Spring Retry's\n * {@code ExponentialBackOffPolicy}, Resilience4j's {@code IntervalFunction.ofExponentialBackoff}), and the delay\n * is a pure function of it and the attempt count; the scheduler does the waiting.\n *\n * <p>The base is positive, the cap at least the base and at most a day: a wait longer than that is a configuration\n * error, and within these bounds the doubling never leaves the range of a {@code long}.\n */\npublic record Backoff(long baseMillis, long capMillis) {\n\n    public static final long MAX_CAP_MILLIS = 86_400_000L;\n\n    public Backoff {\n        if (baseMillis <= 0 || capMillis < baseMillis || capMillis > MAX_CAP_MILLIS) {\n            throw new IllegalArgumentException(\"base must be positive and the cap between the base and a day\");\n        }\n    }\n\n    /**\n     * The delay before the given attempt: the base doubled {@code attempt} times, stopping at the cap. The first\n     * attempt (zero) waits the base, and so does any earlier one.\n     */\n    public long delayMillis(int attempt) {\n        long delay = baseMillis;\n        for (int i = 0; i < attempt && delay < capMillis; i++) {\n            delay = Math.min(capMillis, delay * 2);\n        }\n        return delay;\n    }\n"
    },
    "after": {
      "file": "examples/apps/crosscut/src/main/java/net/terminalvalue/crosscut/retry/Backoff.java",
      "startLine": 1,
      "code": "package net.terminalvalue.crosscut.retry;\n\n/**\n * How long a retry waits: an exponential backoff from {@code baseMillis}, multiplied by {@code multiplier} on\n * each attempt, never longer than {@code capMillis}. The policy is a value, held by the retry filter (Spring\n * Retry's {@code ExponentialBackOffPolicy}, whose multiplier is 2 by default, Resilience4j's\n * {@code IntervalFunction.ofExponentialBackoff}), and the delay is a pure function of it and the attempt count;\n * the scheduler does the waiting.\n *\n * <p>The base is positive, the cap at least the base and at most a day, the multiplier at least two: a wait\n * longer than a day is a configuration error, a multiplier below two no backoff, and within these bounds the\n * growth never leaves the range of a {@code long}.\n */\npublic record Backoff(long baseMillis, long capMillis, int multiplier) {\n\n    public static final long MAX_CAP_MILLIS = 86_400_000L;\n\n    public Backoff {\n        if (baseMillis <= 0 || capMillis < baseMillis || capMillis > MAX_CAP_MILLIS || multiplier < 2) {\n            throw new IllegalArgumentException(\"base must be positive, the cap between the base and a day, the multiplier at least two\");\n        }\n    }\n\n    /**\n     * The delay before the given attempt: the base multiplied {@code attempt} times, stopping at the cap. The\n     * first attempt (zero) waits the base, and so does any earlier one.\n     */\n    public long delayMillis(int attempt) {\n        long delay = baseMillis;\n        for (int left = attempt; left != 0 && delay < capMillis; left--) {\n            delay = Math.min(capMillis, delay * multiplier);\n        }\n        return delay;\n    }\n"
    },
