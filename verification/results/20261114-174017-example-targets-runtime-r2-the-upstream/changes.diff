+    [-1290, 3], [-1291, 3], [3, 19], [3, 20], [10, 10],
+    # the extreme bases
+    [INT_MAX, 1], [INT_MIN, 1], [INT_MAX, 2], [INT_MIN, 2], [INT_MIN, 0], [2, 63], [2, INT_MAX],
