+diff --git a/examples/apps/crosscut/src/main/java/net/terminalvalue/crosscut/ratelimit/Window.java b/examples/apps/crosscut/src/main/java/net/terminalvalue/crosscut/ratelimit/Window.java
+index 8214e20..d999ea3 100644
