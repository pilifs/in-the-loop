++++ b/examples/apps/crosscut/src/main/java/net/terminalvalue/crosscut/ratelimit/Window.java
+@@ -26,7 +26,9 @@ public record Window(long startNanos, long count) {
+         if (windowNanos <= 0 || nowNanos < startNanos) {
+             throw new IllegalArgumentException("the window must be positive and time must not go back");
+         }
+-        long start = nowNanos - nowNanos % windowNanos;
++        // A window that is a power of two, the filter's default, aligns the start by clearing the low bits; any other
++        // by the remainder.
++        long start = (windowNanos & (windowNanos - 1)) == 0 ? nowNanos & -windowNanos : nowNanos - nowNanos % windowNanos;
+         return start == startNanos ? new Window(startNanos, count + 1) : new Window(start, 1);
+     }
