{
  "entry": "org.apache.batik.util.Service#providers(Ljava/lang/Class;)Ljava/util/Iterator;",
  "probeClass": "UpgradeProbe",
  "observer": "Actual resource requests and sorted class names or typed provider instances",
  "basis": "Every registered location mask, one resource root and both orders of two roots. Populated resources contain known lines. An unrelated marker has no matching resource.",
  "cases": [
    {
      "args": [
        "control",
        "0",
        "single"
      ],
      "expected": {
        "return": "META-INF/services/UpgradeProbe$Other="
      }
    },
    {
      "args": [
        "control",
        "0",
        "forward"
      ],
      "expected": {
        "return": "META-INF/services/UpgradeProbe$Other="
      }
    },
    {
      "args": [
        "control",
        "0",
        "reverse"
      ],
      "expected": {
        "return": "META-INF/services/UpgradeProbe$Other="
      }
    },
    {
      "args": [
        "control",
        "1",
        "single"
      ],
      "expected": {
        "return": "META-INF/services/UpgradeProbe$Other="
      }
    },
    {
      "args": [
        "control",
        "1",
        "forward"
      ],
      "expected": {
        "return": "META-INF/services/UpgradeProbe$Other="
      }
    },
    {
      "args": [
        "control",
        "1",
        "reverse"
      ],
      "expected": {
        "return": "META-INF/services/UpgradeProbe$Other="
      }
    }
  ]
}
