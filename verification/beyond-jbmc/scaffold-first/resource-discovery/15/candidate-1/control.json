{
  "entry": "org.jvnet.hudson.annotation_indexer.Index#listClassNames(Ljava/lang/Class;Ljava/lang/ClassLoader;)Ljava/util/Set;",
  "probeClass": "UpgradeProbe",
  "observer": "Actual resource requests and sorted class names or typed provider instances",
  "basis": "Every registered location mask, one resource root and both orders of two roots. Populated resources contain known lines. An unrelated marker has no matching resource.",
  "cases": [
    {
      "args": [
        "control",
        "0",
        "single"
      ],
      "expected": {
        "return": "META-INF/annotations/java.lang.Override|META-INF/services/annotations/java.lang.Override="
      }
    },
    {
      "args": [
        "control",
        "0",
        "forward"
      ],
      "expected": {
        "return": "META-INF/annotations/java.lang.Override|META-INF/services/annotations/java.lang.Override="
      }
    },
    {
      "args": [
        "control",
        "0",
        "reverse"
      ],
      "expected": {
        "return": "META-INF/annotations/java.lang.Override|META-INF/services/annotations/java.lang.Override="
      }
    },
    {
      "args": [
        "control",
        "3",
        "single"
      ],
      "expected": {
        "return": "META-INF/annotations/java.lang.Override|META-INF/services/annotations/java.lang.Override="
      }
    },
    {
      "args": [
        "control",
        "3",
        "forward"
      ],
      "expected": {
        "return": "META-INF/annotations/java.lang.Override|META-INF/services/annotations/java.lang.Override="
      }
    },
    {
      "args": [
        "control",
        "3",
        "reverse"
      ],
      "expected": {
        "return": "META-INF/annotations/java.lang.Override|META-INF/services/annotations/java.lang.Override="
      }
    }
  ]
}
